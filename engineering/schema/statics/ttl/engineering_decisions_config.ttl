# =====================================================================
# XAAI Lexicon Database — Project configuration profile (SHACL).
#
# Target artefact:   (this file is loaded ALONGSIDE the core shapes)
# Companion shapes:  engineering_decisions.record.shacl.ttl
#                    engineering_decisions.consequences.shacl.ttl
#                    engineering_decisions.implementation.shacl.ttl
#                    engineering_decisions.results.shacl.ttl
# Generated by:      Claude Opus 4.7 (1M context) via Claude Code
# Date:              2026-05-19
# Version:           2.0 (extracted from inline record/consequences shapes)
#
# DISCLAIMER (per CLAUDE.md):
#   No statement or premise not backed by a real logical definition or
#   verifiable reference should be taken for granted.
#
# MODEL INTENT:
#   The core SHACL files are project-agnostic; this file holds the
#   XAAI-specific bits that previously hard-coded the shapes:
#     • the closed category vocabulary (26 values)
#     • the anchor-property regex patterns
#         (schema.sql / load_yaml_to_sql.py / pyproject.toml)
#     • tunables consumed by the results-freshness shape
#
#   To reuse the core shapes on another codebase, swap this file. The
#   core shapes only require that `rec:category` and the *_anchor
#   properties exist with the right datatype; closed-list and regex
#   enforcement live HERE.
#
#   Validate with:
#       pyshacl -s engineering_decisions.record.shacl.ttl \
#               -s engineering_decisions.config.ttl       \
#               -d /tmp/eng.ttl
# =====================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix cfg:     <https://xaai.ai/lexicon/decisions-config#> .
@prefix rec:     <https://xaai.ai/lexicon/decisions-record#> .
@prefix res:     <https://xaai.ai/lexicon/decisions-results#> .
@prefix cons:    <https://xaai.ai/lexicon/consequences#> .

# =====================================================================
# 1. Ontology header
# =====================================================================

cfg: a owl:Ontology ;
    dcterms:title    "XAAI Lexicon — Decisions Config (project-specific)" ;
    dcterms:source   "engineering_decisions.yml" ;
    dcterms:created  "2026-05-19"^^xsd:date ;
    dcterms:creator  "Claude Opus 4.7 (1M context) via Claude Code" ;
    rdfs:comment     "Externalized project-specific vocabulary so the core SHACL shapes are reusable." .

# =====================================================================
# 2. Category vocabulary — closed enum for THIS project
# =====================================================================

cfg:CategoryShape
    a sh:NodeShape ;
    rdfs:label "Category closed-list enforcement" ;
    sh:targetSubjectsOf rec:category ;
    sh:property [
        sh:path rec:category ;
        sh:in (
            # --- Schema & data modelling -----------------------------
            "constraints"
            "data-integrity"
            "data-normalization"
            "defaults"
            "enums"
            "identity"
            "indexing"
            "naming"
            "persistence"
            "relationship-semantics"
            "schema-design"
            "schema-structure"
            "typing"

            # --- Lifecycle & evolution -------------------------------
            "deferred"
            "evolution"
            "extensibility"
            "limitation"
            "scope"
            "versioning"

            # --- Provenance & evidence -------------------------------
            "auditability"
            "documentation"
            "provenance"

            # --- Engineering operations ------------------------------
            "code-quality"
            "operations"
            "runtime-target"
            "tooling"

            # --- Testing & quality (PGFS extensions, 2026-05) --------
            # Distinct axes: `test-automation` = automated test machinery
            # exists/runs; `test-methodology` = how tests are authored
            # (regression-first / TDD); `test-technique` = property,
            # snapshot, fuzzing; `contract-quality` = drift guards on
            # declared contracts; `criticality` = which surfaces carry
            # elevated coverage expectations.
            "contract-quality"
            "criticality"
            "test-automation"
            "test-methodology"
            "test-technique"

            # --- Runtime, observability, performance (PGFS, 2026-05) -
            # `observability` is runtime measurement (profiling, traces);
            # `auditability` (above) remains audit-time checkability —
            # they intentionally do NOT collapse. `performance` is its
            # own axis; `runtime-quality` is end-to-end readiness of
            # the running system (mount-level smoke, etc.).
            "observability"
            "performance"
            "runtime-quality"

            # --- Release, security, supply-chain (PGFS, 2026-05) -----
            "release-quality"
            "security"
            "supply-chain"
            "technical-debt"
        ) ;
        sh:message "category must be one of the 38 known values; extend this project config before introducing a new one." ;
    ] .

# =====================================================================
# 3. Anchor patterns — file-name-specific regex for THIS project
# =====================================================================

cfg:SchemaAnchorShape
    a sh:NodeShape ;
    rdfs:label "schema_anchor pattern" ;
    sh:targetSubjectsOf rec:schemaAnchor ;
    sh:property [
        sh:path rec:schemaAnchor ;
        sh:pattern "^schema\\.sql:[0-9]+" ;
        sh:message "schema_anchor entries must start with \"schema.sql:<line>\"." ;
    ] .

cfg:LoaderAnchorShape
    a sh:NodeShape ;
    rdfs:label "loader_anchor pattern" ;
    sh:targetSubjectsOf rec:loaderAnchor ;
    sh:property [
        sh:path rec:loaderAnchor ;
        sh:pattern "^load_yaml_to_sql\\.py:[0-9]+" ;
        sh:message "loader_anchor entries must start with \"load_yaml_to_sql.py:<line>\"." ;
    ] .

cfg:PyprojectAnchorShape
    a sh:NodeShape ;
    rdfs:label "pyproject_anchor pattern" ;
    sh:targetSubjectsOf rec:pyprojectAnchor ;
    sh:property [
        sh:path rec:pyprojectAnchor ;
        sh:pattern "^pyproject\\.toml:[0-9]+" ;
        sh:message "pyproject_anchor entries must start with \"pyproject.toml:<line>\"." ;
    ] .

# =====================================================================
# 4. Tunable policy parameters
#
#   These are read by the runner and by the SHACL-SPARQL constraints
#   in the consequences/results shapes. Encoded as RDF so they can be
#   referenced from SPARQL via the cfg:Policy singleton.
#
#   IMPORTANT — DATA GRAPH INJECTION:
#     SHACL-SPARQL constraints execute their queries against the DATA
#     graph, not the union of data+shapes. The cfg:policy triples live
#     in this (shapes) file, so any constraint that consults the policy
#     will silently see NO policy unless this file is *also* loaded as
#     data — or merged into the data graph before validation.
#
#   The runner MUST load this file with BOTH `-s` (shapes) AND `-d`
#   (data), e.g.:
#
#     pyshacl -s engineering_decisions.consequences.shacl.ttl   \\
#             -s engineering_decisions.config.ttl               \\
#             -d engineering_decisions.config.ttl               \\
#             -d /tmp/cons.ttl
#
#   Forgetting the second `-d` will cause every policy-aware rule to
#   short-circuit to "no constraint" because cfg:policy has no triples
#   in the data graph. The sanity guard below catches that.
# =====================================================================

cfg:Policy a rdfs:Class ;
    rdfs:label "Policy singleton (tunable runner / freshness params)" .

cfg:freshnessWindowDays
    a rdf:Property ;
    rdfs:domain cfg:Policy ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Max age in days for a CheckResult to still count as fresh." .

cfg:strictSideEffectsOnShell
    a rdf:Property ;
    rdfs:domain cfg:Policy ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "If true, shell/python-call checks must declare sideEffects explicitly (no default). Consumed by cons:CheckShape via SPARQL." .

cfg:allowedCheckContexts
    a rdf:Property ;
    rdfs:domain cfg:Policy ;
    rdfs:range  cons:Context ;
    rdfs:comment "Contexts the runner is willing to dispatch to in this project. Consumed by cons:CheckShape via SPARQL — multi-valued, one triple per allowed context." .

cfg:policy
    a cfg:Policy ;
    cfg:freshnessWindowDays      14 ;
    cfg:strictSideEffectsOnShell true ;
    cfg:allowedCheckContexts     cons:workspace , cons:ci .

# Optional: enforce that the policy singleton exists and is well-formed.
cfg:PolicyShape
    a sh:NodeShape ;
    sh:targetClass cfg:Policy ;
    sh:property [
        sh:path cfg:freshnessWindowDays ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:message "freshnessWindowDays is required and must be >= 1 (read by res:FreshnessShape)." ;
    ] ;
    sh:property [
        sh:path cfg:strictSideEffectsOnShell ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "strictSideEffectsOnShell is required (read by cons:CheckShape)." ;
    ] ;
    sh:property [
        sh:path cfg:allowedCheckContexts ;
        sh:in ( cons:workspace cons:ci cons:runtime cons:infra ) ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "allowedCheckContexts must list at least one of { cons:workspace, cons:ci, cons:runtime, cons:infra } (closed enum)." ;
    ] .

# Singleton enforcement — at most one cfg:Policy instance, and if any
# exists it must be cfg:policy. Existence is *not* enforced because
# cfg:policy ships in this file (the shapes graph); enforcing existence
# in the data graph would fail every empty-data validation.
cfg:PolicySingletonShape
    a sh:NodeShape ;
    sh:targetClass cfg:Policy ;
    sh:sparql [
        sh:message "The only allowed cfg:Policy instance is cfg:policy." ;
        sh:select """
            PREFIX cfg: <https://xaai.ai/lexicon/decisions-config#>
            SELECT $this WHERE {
              FILTER ($this != cfg:policy)
            }
        """ ;
    ] .

# =====================================================================
# End of file
# =====================================================================
