# Generic patterns only. Anything private to one machine or one operator belongs in
# the local working store (DOCRAY_WORK_DIR, outside the repository); paths that must
# exist locally but never ship go in .git/info/exclude, not here.

# Python / tooling
*.pyc
__pycache__/
*egg-info*
.venv
.venv-proto/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/

# Secrets and per-host environment (samples are tracked: .env*.example)
.env
.env.*
!.env.example
!.env.prod.example
!.env.test.example
*.bak.*
.mcp.json
pgadmin/servers.json
.claude/settings.json
.claude/settings.local.json

# Build products and archives
*.tar

# Local scratch: the single in-repo scratch area a tool may fall back to when
# DOCRAY_WORK_DIR is unset. Never shipped, never committed.
_work/

# Local operational data (not source): ingest staging, dumps, downloaded corpora.
_ingest/
.ingest-state/
backups/
books/

# Vendored agent tooling bundle (local)
.repo/

# Documentation-hygiene tooling output (generated locally, reviewed, never committed)
.doc-quarantine/
doc-hygiene-report.md
doc-quarantine.sh
quarantine-manifest.json
quarantine-summaries.md

# Third-party design/theme archives held for reference only. Commercially
# licensed (ThemeForest et al.) and the licence terms are not in the archive, so
# the bytes must never enter this repo's history. Nothing here ships: the theme
# is read as a capability reference, and the UI is built on webapp/static/
# design-system.css.
vendors/
