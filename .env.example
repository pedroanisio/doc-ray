# Copy to `.env` and adjust. docker-compose reads this automatically.

# --- Logging (worker + API processes, doc_ray.logging_setup) ---
# Level for the root logger; format is a standard `logging` format string.
# Defaults: INFO, "%(asctime)s %(levelname)s %(name)s %(message)s".
DOCRAY_LOG_LEVEL=INFO
DOCRAY_LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s

# --- Postgres ---
POSTGRES_USER=docray
# Replace this before starting Compose; docker-compose rejects the historical
# default (`docray`) and placeholder values.
POSTGRES_PASSWORD=change-me-docray
POSTGRES_DB=docray
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Used by the ingester when run OUTSIDE docker (on the host) ---
DATABASE_URL=postgresql://docray:change-me-docray@localhost:5432/docray
S3_ENDPOINT=http://localhost:9000
# Local MinIO uses plaintext HTTP. Keep this unset/0 for non-local object stores.
S3_ALLOW_INSECURE_ENDPOINT=1
# Optional object-store server-side encryption. Use AES256 or aws:kms when supported.
S3_SERVER_SIDE_ENCRYPTION=
S3_SSE_KMS_KEY_ID=
# Overrides the migration directory the runner/entrypoints.migrate reads from
# (defaults to the packaged db/migrations); mainly a test/packaging hook.
# DOCRAY_MIGRATIONS_DIR=
# Explicit local override for DB-backed integration tests pointed at a non-test
# database. Leave disabled; prefer scripts/test-in-docker.sh for validation.
DOCRAY_TEST_ALLOW_LIVE_DB=0

# --- Optional PDF math extraction backend ---
# Set to `external` to route PDFs through a Docling/Marker/Nougat-style command
# that reads PDF bytes on stdin and emits verified JSON with LaTeX-bearing
# full_text on stdout. Invalid or non-LaTeX output is rejected before persistence.
DOCRAY_PDF_MATH_BACKEND=
DOCRAY_PDF_MATH_BACKEND_CMD=
DOCRAY_PDF_MATH_BACKEND_TIMEOUT=120

# --- Optional PDF OCR (image-only pages) ---
# Set to 1/true/yes/on to run PyMuPDF/Tesseract OCR when a PDF extracts to
# (near-)zero characters. DOCRAY_PDF_OCR_LANGUAGE is a Tesseract language code.
DOCRAY_PDF_OCR=
DOCRAY_PDF_OCR_LANGUAGE=eng

# --- PDF heading-detection calibration ---
# Font-size ratio (vs. body text) above which a line is treated as an H1/H2/H3
# heading, and the word count above which a bold line stops being treated as a
# heading candidate. Defaults match domain/pdf_layout.py's HeadingThresholds.
DOCRAY_PDF_HEADING_L1_RATIO=1.5
DOCRAY_PDF_HEADING_L2_RATIO=1.25
DOCRAY_PDF_HEADING_L3_RATIO=1.1
DOCRAY_PDF_HEADING_BOLD_MAX_WORDS=10

# --- EPUB/DOCX extraction hardening ---
# Both formats are zip containers; a small compressed upload could otherwise
# declare an arbitrarily large uncompressed payload (a decompression bomb).
# Rejected before any XML parsing begins. Default 500 MiB.
DOCRAY_EXTRACT_MAX_UNCOMPRESSED_MB=500

# --- spaCy annotation ---
# "fail" (default) aborts the annotate job if the document's language has no
# installed spaCy model; "fallback" degrades to a default model instead.
DOCRAY_SPACY_FALLBACK_POLICY=fail

# --- Frontier resolver (entity-resolution LLM calls, opt-in/explicit only) ---
# DOCRAY_RESOLVER_MODEL=claude-opus-4-8

# --- GraphQL API ---
DOCRAY_API_POOL_MIN_SIZE=1
DOCRAY_API_POOL_MAX_SIZE=10
DOCRAY_API_POOL_TIMEOUT=10
# Postgres statement_timeout (ms) applied to every pooled connection, so one
# unbounded query (e.g. a corpus-wide aggregation) fails fast instead of
# monopolizing a backend indefinitely.
DOCRAY_API_STATEMENT_TIMEOUT_MS=15000
# Query-safety caps (schema.py) — max GraphQL query nesting depth and max
# token/complexity count. Defaults: 12 and 2000.
API_MAX_DEPTH=12
API_MAX_TOKENS=2000
# token=principal_uuid[:scope+scope], entries separated by comma or semicolon.
# Leave empty for local anonymous access scoped by database RLS.
DOCRAY_API_TOKENS=
DOCRAY_API_ALLOW_ANONYMOUS=true
# Locally issued API JWTs (BL-071/BL-072). Set DOCRAY_API_JWT_SECRET to enable
# /auth/token exchange from a valid static credential. Access tokens are
# short-lived; refresh tokens allow rotation without reusing the static secret.
# DOCRAY_API_JWT_SECRET=
DOCRAY_API_JWT_ISSUER=doc-ray
# DOCRAY_API_JWT_AUDIENCE=
DOCRAY_API_JWT_TTL_SECONDS=900
DOCRAY_API_REFRESH_TOKEN_TTL_SECONDS=86400
# Local self-service registration/login. Admin principals remain
# seed/operator-managed; registered users receive the reader role and must
# verify email before login. Keep verification-token exposure false outside
# tests/local diagnostics; production should deliver the token by email.
DOCRAY_AUTH_LOCAL_ENABLED=false
DOCRAY_AUTH_REGISTRATION_ENABLED=false
DOCRAY_AUTH_EXPOSE_VERIFICATION_TOKEN=false
DOCRAY_AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# OIDC bearer JWTs become the default authenticator when issuer + JWKS are set.
# Static DOCRAY_API_TOKENS are then rejected unless this explicit break-glass /
# local-dev fallback is enabled. Keep false in normal federated deployments.
# DOCRAY_API_OIDC_ISSUER=
# DOCRAY_API_OIDC_AUDIENCE=
# DOCRAY_API_OIDC_JWKS_JSON=
# DOCRAY_API_OIDC_AUTO_CREATE_PRINCIPALS=false
DOCRAY_API_OIDC_ALLOW_STATIC_TOKEN_FALLBACK=false
# SCIM provisioning bearer tokens map token=tenant_uuid. Leave empty unless an
# IdP is syncing principals/groups into /scim/v2/{tenant_id}.
DOCRAY_SCIM_TOKENS=
# GraphQL introspection + the interactive GraphiQL IDE are disabled unless this
# is set — an anonymous caller (the default above) should not be able to
# enumerate the schema, including admin-only mutation shapes, for free
# reconnaissance. Set true only for local development.
DOCRAY_API_DEBUG=
# GraphQL endpoint the webapp posts mutations to (entrypoints.api service URL).
DOCRAY_API_URL=http://localhost:8000/graphql

# --- Scheduled backups and ops monitors ---
DOCRAY_BACKUP_SCHEDULE_SECONDS=86400
DOCRAY_BACKUP_RETENTION_COUNT=7
DOCRAY_BACKUP_RETENTION_DAYS=30
DOCRAY_DB_HEALTH_INTERVAL_SECONDS=300

# --- Worker (entrypoints.worker) ---
# Seconds between claim attempts when the queue is empty; heartbeat interval
# while a job runs; how long a missed heartbeat is tolerated before a job is
# reclaimed as stale. Defaults: 5, 15, 120.
WORKER_POLL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_CLAIM_TIMEOUT_SECONDS=120
# Janitor cadence: stale jobs are reaped on this timer even while every worker
# is busy inside a long handler (recovery otherwise waits for a free slot).
WORKER_REAP_SECONDS=30
# Wall-clock timeout for one claimed job; <=0 disables. Kind-specific overrides
# use WORKER_JOB_TIMEOUT_<KIND>_SECONDS, e.g. WORKER_JOB_TIMEOUT_BACKUP_SECONDS.
# Defaults: 3600 for any kind, 60 for Claude resolver HTTP calls.
WORKER_JOB_TIMEOUT_SECONDS=3600
DOCRAY_RESOLVER_TIMEOUT_SECONDS=60
# Backoff before reconnecting after a dropped DB connection (BL-101), so a
# transient blip doesn't crash the worker process. Default: 2.
WORKER_RECONNECT_BACKOFF_SECONDS=2
# Kind filters for a worker's claims (comma-separated; unset = claim any kind).
# The compose worker-fast service sets WORKER_EXCLUDE_KINDS=annotate,reannotate
# (override via WORKER_FAST_EXCLUDE_KINDS) as a reserved short-job lane, so
# user-facing jobs never queue behind hours-long spaCy runs.
# WORKER_ONLY_KINDS=
# WORKER_EXCLUDE_KINDS=

# --- Webapp (webapp/app.py) ---
# Flask port for `python -m webapp.app` (ignored under `flask run --port`).
PORT=5001
# Host port for the compose `webapp` service (bound to 127.0.0.1).
WEBAPP_PORT=5001
# Host ports for the nginx TLS front door (binds all interfaces): HTTPS
# serving port and the plain-HTTP port that 301-redirects onto it.
NGINX_HTTPS_PORT=443
NGINX_HTTP_PORT=80
# Signs the session cookie carrying each session's CSRF token (BL-103). Unset
# falls back to a random key generated at process start (dev-only — every
# session is invalidated on restart); set explicitly for a real deployment.
# DOCRAY_WEBAPP_SECRET_KEY=
# Caps upload size in MB before it's fully buffered for hashing — enforced by
# both the webapp's Flask route and the GraphQL ingestDocument mutation (BL-098).
DOCRAY_MAX_UPLOAD_MB=200
# Per-client fixed-window throttles for expensive webapp routes (BL-105). Set
# REQUESTS to 0 to disable a route limit.
DOCRAY_WEBAPP_SEARCH_RATE_LIMIT_REQUESTS=60
DOCRAY_WEBAPP_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
DOCRAY_WEBAPP_UPLOAD_RATE_LIMIT_REQUESTS=10
DOCRAY_WEBAPP_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# Webapp per-user login sessions (BL-070). The Flask cookie stores only an
# opaque server-side session id; principal identity and expiry live in the
# webapp process. Keep Secure=true when serving through nginx/TLS.
DOCRAY_WEBAPP_SESSION_TTL_SECONDS=28800
DOCRAY_WEBAPP_SESSION_COOKIE_SECURE=true
# OIDC browser login. Configure authorization + token endpoints, client id, and
# JWKS/issuer values. The API OIDC issuer/audience/JWKS settings are reused when
# the webapp-specific variants are unset.
# DOCRAY_WEBAPP_OIDC_AUTHORIZATION_URL=
# DOCRAY_WEBAPP_OIDC_TOKEN_URL=
# DOCRAY_WEBAPP_OIDC_CLIENT_ID=
# DOCRAY_WEBAPP_OIDC_CLIENT_SECRET=
DOCRAY_WEBAPP_OIDC_SCOPE=openid email profile
# DOCRAY_WEBAPP_OIDC_ISSUER=
# DOCRAY_WEBAPP_OIDC_AUDIENCE=
# DOCRAY_WEBAPP_OIDC_JWKS_JSON=
# SAML browser login. The IdP posts SAMLResponse back to /auth/saml/callback;
# unsigned assertions are for local/test IdPs only.
# DOCRAY_WEBAPP_SAML_SSO_URL=
# DOCRAY_WEBAPP_SAML_TENANT_ID=
# DOCRAY_WEBAPP_SAML_IDP_ENTITY_ID=
# DOCRAY_WEBAPP_SAML_SP_ENTITY_ID=
DOCRAY_WEBAPP_SAML_ALLOW_UNSIGNED_ASSERTIONS=false
# Bearer token required to view /operator/health; unset hides the page (404).
# DOCRAY_OPERATOR_HEALTH_TOKEN=
# A running job whose heartbeat is older than this (seconds) renders as
# "Stalled (worker lost)" and stops blocking the reprocess buttons. Keep well
# above WORKER_CLAIM_TIMEOUT_SECONDS to avoid flapping. Default: 300.
DOCRAY_WEBAPP_STALLED_AFTER_SECONDS=300
# Heartbeat age (seconds) past which the job page stops trusting a running
# job's progress numbers and warns instead (the backend already considers such
# a heartbeat reclaimable). Mirrors WORKER_CLAIM_TIMEOUT_SECONDS' default;
# deliberately tighter than DOCRAY_WEBAPP_STALLED_AFTER_SECONDS. Default: 120.
DOCRAY_WEBAPP_HEARTBEAT_RECLAIM_ELIGIBLE_SECONDS=120

# --- Access control (webapp RLS enforcement — see db/migrations/018_rbac.sql) ---
# Leave DOCRAY_PRINCIPAL_ID unset for local/dev: the webapp connects as the
# superuser and RLS is bypassed (sees everything). To enforce document-level
# access, set it to a row from `principals.id`; the webapp then SET ROLE
# docray_client and stamps that principal, so only permitted documents are visible.
# DOCRAY_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
# DOCRAY_DB_ROLE=docray_client

# --- Webapp -> API write auth ---
# The webapp's own DB connection (above) only scopes its direct, read-only
# Postgres queries. Every WRITE goes over HTTP to the GraphQL API instead, and
# that API requires a write-scoped principal (entrypoints/api/mutation.py
# `_require_write`) — anonymous callers are always read-only regardless of
# DOCRAY_API_ALLOW_ANONYMOUS. Set this to one of the tokens listed in
# DOCRAY_API_TOKENS above so the webapp can call ingestDocument/reannotate/etc.
# DOCRAY_WEBAPP_API_TOKEN=
