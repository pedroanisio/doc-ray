# =====================================================================
# XAAI Lexicon Database — SHACL shapes for the WITH-IMPLEMENTATION YAML.
#
# Target artefact:   engineering_decisions.with_implementation.yml
# Companion shapes:  engineering_decisions.record.shacl.ttl
#                    engineering_decisions.consequences.shacl.ttl
#                    engineering_decisions.results.shacl.ttl
#                    engineering_decisions.config.ttl
# Generated by:      Claude Opus 4.7 (1M context) via Claude Code
# Date:              2026-05-19
# Version:           1.0 (new in v2)
#
# DISCLAIMER (per CLAUDE.md):
#   No statement or premise not backed by a real logical definition or
#   verifiable reference should be taken for granted.
#
# MODEL INTENT:
#   Parallel structure to consequences, for the IMPLEMENTATION side:
#
#     DecisionRef --hasImplementation--> Implementation --hasStep--> Step
#
#   Each Implementation declares:
#     • automatable (boolean) — can this decision be applied by code?
#     • status      ∈ { not-applicable, pending, populated }
#     • reason      (required when automatable=false)
#     • steps       — ordered list of idempotent operations
#
#   Each Step declares:
#     • stepId (D-NNN.iN), description, stepKind, context
#     • idempotent (REQUIRED boolean) — every step must declare whether
#       it is safe to retry. If false, idempotencyJustification is
#       required so a reviewer can understand the contract.
#     • sideEffects is implicitly `writes` (this is the application
#       half — steps without side-effects are no-ops).
#     • Optional precondition / postcondition references into the
#       consequences graph (a Check id that must hold before/after).
#
#   Step kinds (7):
#     shell-write, python-call, file-write, file-patch, toml-set,
#     sql-exec, custom
#
#   State interlocks mirror Claim's:
#     automatable=false ⇒ reason set, no steps
#     status=populated  ⇒ at least one step
#     status=pending    ⇒ explicit empty steps list
#
# Validate with:
#       python3 scripts/implementation_to_rdf.py engineering_decisions.with_implementation.yml > /tmp/impl.ttl
#       pyshacl -s engineering_decisions.implementation.shacl.ttl \
#               -s engineering_decisions.config.ttl                \
#               -d /tmp/impl.ttl
# =====================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix impl:    <https://xaai.ai/lexicon/implementation#> .
@prefix cons:    <https://xaai.ai/lexicon/consequences#> .

# =====================================================================
# 1. Ontology header
# =====================================================================

impl: a owl:Ontology ;
    dcterms:title    "XAAI Lexicon — Idempotent Implementation (SHACL)" ;
    dcterms:source   "engineering_decisions.with_implementation.yml" ;
    dcterms:created  "2026-05-19"^^xsd:date ;
    dcterms:creator  "Claude Opus 4.7 (1M context) via Claude Code" ;
    owl:versionInfo  "1.0" ;
    rdfs:comment     "Shapes for the application/idempotent-apply half of decisions, parallel to consequences." .

# =====================================================================
# 2. Vocabulary — classes
# =====================================================================

impl:Implementation a rdfs:Class ;
    rdfs:label "Implementation block (zero-or-one per Decision)" .

impl:Step a rdfs:Class ;
    rdfs:label "Step (one idempotent operation within an Implementation)" .

# Status enum
impl:Status a rdfs:Class .
impl:notApplicable a impl:Status .  # YAML literal: "not-applicable"
impl:pending       a impl:Status .
impl:populated     a impl:Status .

# Context enum — REUSED from cons:Context (D3.5).
# We do not redeclare workspace/ci/runtime/infra here; the implementation
# graph imports cons: and references the same individuals so the two
# vocabularies cannot drift apart.

# StepKind enum
impl:StepKind  a rdfs:Class .
impl:shellWrite  a impl:StepKind .   # YAML literal: "shell-write"
impl:pythonCall  a impl:StepKind .   # YAML literal: "python-call"
impl:fileWrite   a impl:StepKind .   # YAML literal: "file-write"
impl:filePatch   a impl:StepKind .   # YAML literal: "file-patch"
impl:tomlSet     a impl:StepKind .   # YAML literal: "toml-set"
impl:sqlExec     a impl:StepKind .   # YAML literal: "sql-exec"
impl:custom      a impl:StepKind .

# =====================================================================
# 3. Vocabulary — properties
# =====================================================================

# DecisionRef -> Implementation (0..1)
impl:hasImplementation a rdf:Property ;
    rdfs:domain cons:DecisionRef ; rdfs:range impl:Implementation .

# Implementation fields
impl:automatable   a rdf:Property ; rdfs:domain impl:Implementation ; rdfs:range xsd:boolean .
impl:status        a rdf:Property ; rdfs:domain impl:Implementation ; rdfs:range impl:Status .
impl:reason        a rdf:Property ; rdfs:domain impl:Implementation ; rdfs:range xsd:string .
impl:hasStep       a rdf:Property ; rdfs:domain impl:Implementation ; rdfs:range impl:Step .
impl:declaredStepsCount a rdf:Property ; rdfs:domain impl:Implementation ; rdfs:range xsd:integer .

# Step core
impl:stepId        a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:string .
impl:description   a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:string .
impl:stepKind      a rdf:Property ; rdfs:domain impl:Step ; rdfs:range impl:StepKind .
impl:order         a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:integer .
impl:context       a rdf:Property ; rdfs:domain impl:Step ; rdfs:range cons:Context .
impl:idempotent    a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:boolean .
impl:idempotencyJustification a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:string .
impl:dryRunCommand a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:string .
impl:rollbackHint  a rdf:Property ; rdfs:domain impl:Step ; rdfs:range xsd:string .

# D4.6: explicit side-effects declaration on Steps. Reuses cons:SideEffects
# so the drift-purity rule from consequences extends to implementation.
# Default semantics when absent: writes (a Step that doesn't write is a
# no-op and should be documented as such by setting this explicitly).
impl:sideEffects   a rdf:Property ; rdfs:domain impl:Step ; rdfs:range cons:SideEffects .

# Cross-graph references to consequences:
#   - precondition: a Check that must PASS before this Step runs
#   - postcondition: a Check that must PASS after this Step runs
# We reference by Check IRI (cons:Check) since both graphs share the
# same projection IRI scheme.
impl:precondition  a rdf:Property ; rdfs:domain impl:Step ; rdfs:range cons:Check .
impl:postcondition a rdf:Property ; rdfs:domain impl:Step ; rdfs:range cons:Check .

# Kind-specific payload fields
impl:command        a rdf:Property ; rdfs:range xsd:string .   # shell-write
impl:fn             a rdf:Property ; rdfs:range xsd:string .   # python-call
impl:args           a rdf:Property ; rdfs:range rdf:List .     # python-call
impl:path           a rdf:Property ; rdfs:range xsd:string .   # file-write, file-patch
impl:content        a rdf:Property ; rdfs:range xsd:string .   # file-write
impl:patchScript    a rdf:Property ; rdfs:range xsd:string .   # file-patch (e.g. unified diff or jq/yq expr)
impl:key            a rdf:Property ; rdfs:range xsd:string .   # toml-set (dotted path)
impl:value          a rdf:Property ; rdfs:range xsd:string .   # toml-set (JSON-serialised)
impl:sql            a rdf:Property ; rdfs:range xsd:string .   # sql-exec
impl:targetEnv      a rdf:Property ; rdfs:range xsd:string .   # sql-exec / shell-write env

# =====================================================================
# 4. DecisionRef interlock — at most one Implementation per Decision
# =====================================================================

impl:DecisionRefImplementationShape
    a sh:NodeShape ;
    sh:targetClass cons:DecisionRef ;
    sh:property [
        sh:path impl:hasImplementation ;
        sh:class impl:Implementation ;
        sh:maxCount 1 ;
        sh:message "A DecisionRef may carry at most one Implementation block." ;
    ] .

# =====================================================================
# 5. Implementation shape — state interlock
# =====================================================================

impl:ImplementationShape
    a sh:NodeShape ;
    sh:targetClass impl:Implementation ;

    sh:property [
        sh:path impl:automatable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Implementation must declare `automatable` as a boolean." ;
    ] ;
    sh:property [
        sh:path impl:status ;
        sh:in ( impl:notApplicable impl:pending impl:populated ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "status must be one of { not-applicable, pending, populated }." ;
    ] ;
    sh:property [
        sh:path impl:reason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path impl:declaredStepsCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "declaredStepsCount records len(steps) verbatim from the YAML." ;
    ] ;

    # ---- State interlocks ------------------------------------------
    sh:sparql [
        sh:message "automatable=false requires a non-empty `reason` and forbids any `steps`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:automatable false .
              FILTER (
                NOT EXISTS { $this impl:reason ?r }
                || EXISTS { $this impl:hasStep ?s }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "automatable=false requires status=not-applicable." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:automatable false .
              $this impl:status ?s .
              FILTER (?s != impl:notApplicable)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "status=populated requires at least one step." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:status impl:populated .
              FILTER NOT EXISTS { $this impl:hasStep ?s }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "status=pending requires steps to be an explicit empty list (declaredStepsCount=0, no hasStep)." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:status impl:pending .
              FILTER (
                EXISTS { $this impl:hasStep ?s }
                || NOT EXISTS { $this impl:declaredStepsCount 0 }
              )
            }
        """ ;
    ] .

# =====================================================================
# 6. Step shape — common fields + idempotency contract
# =====================================================================

impl:StepShape
    a sh:NodeShape ;
    sh:targetClass impl:Step ;

    sh:property [
        sh:path impl:stepId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^D-[0-9]{3}\\.i[0-9]+$" ;
        sh:message "step.id must match ^D-NNN.iN$ (e.g. \"D-007.i2\")." ;
    ] ;
    sh:property [
        sh:path impl:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 8 ;
        sh:message "Every step must carry a non-empty description (>=8 chars)." ;
    ] ;
    sh:property [
        sh:path impl:stepKind ;
        sh:in (
            impl:shellWrite impl:pythonCall impl:fileWrite impl:filePatch
            impl:tomlSet impl:sqlExec impl:custom
        ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "stepKind must be one of the seven documented kinds." ;
    ] ;
    sh:property [
        sh:path impl:order ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:message "order is a required positive integer (steps execute in ascending order)." ;
    ] ;
    sh:property [
        sh:path impl:context ;
        sh:in ( cons:workspace cons:ci cons:runtime cons:infra ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "context must be one of { workspace, ci, runtime, infra } (shared with cons:Context)." ;
    ] ;
    sh:property [
        sh:path impl:idempotent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every step MUST declare cons:idempotent (true | false). This is the implementation contract." ;
    ] ;
    sh:property [
        sh:path impl:idempotencyJustification ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 16 ;
    ] ;
    sh:property [
        sh:path impl:precondition ;
        sh:class cons:Check ;
        sh:nodeKind sh:IRI ;
        sh:message "precondition, if present, must reference a Check IRI from the consequences graph." ;
    ] ;
    sh:property [
        sh:path impl:postcondition ;
        sh:class cons:Check ;
        sh:nodeKind sh:IRI ;
        sh:message "postcondition, if present, must reference a Check IRI from the consequences graph." ;
    ] ;
    sh:property [
        sh:path impl:sideEffects ;
        sh:in ( cons:noEffect cons:reads cons:writes ) ;
        sh:maxCount 1 ;
        sh:message "sideEffects, if present, must be one of { none, reads, writes } (shared with cons:SideEffects)." ;
    ] ;

    # ---- Idempotency contract --------------------------------------
    sh:sparql [
        sh:message "idempotent=false requires idempotencyJustification (>=16 chars) so a reviewer can audit the retry semantics." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:idempotent false .
              FILTER NOT EXISTS { $this impl:idempotencyJustification ?j }
            }
        """ ;
    ] ;
    # D4.5: rollback hint is required when a step is non-idempotent AND
    # actually mutates state. Context doesn't matter — a non-idempotent
    # writer in `workspace` (e.g. modifying ~/.aws/credentials) is just
    # as dangerous as one in `runtime`.
    sh:sparql [
        sh:message "Non-idempotent steps with sideEffects=writes require an impl:rollbackHint." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this impl:idempotent false ;
                    impl:sideEffects cons:writes .
              FILTER NOT EXISTS { $this impl:rollbackHint ?r }
            }
        """ ;
    ] ;

    # ---- Per-kind required-field SPARQL guards ----------------------
    sh:sparql [
        sh:message "shell-write steps require `command`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:shellWrite .
              FILTER NOT EXISTS { $this impl:command ?c }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "python-call steps require `fn`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:pythonCall .
              FILTER NOT EXISTS { $this impl:fn ?f }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "file-write steps require `path` and `content`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:fileWrite .
              FILTER (
                NOT EXISTS { $this impl:path ?p }
                || NOT EXISTS { $this impl:content ?c }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "file-patch steps require `path` and `patchScript`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:filePatch .
              FILTER (
                NOT EXISTS { $this impl:path ?p }
                || NOT EXISTS { $this impl:patchScript ?s }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "toml-set steps require `path`, `key`, and `value`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:tomlSet .
              FILTER (
                NOT EXISTS { $this impl:path ?p }
                || NOT EXISTS { $this impl:key ?k }
                || NOT EXISTS { $this impl:value ?v }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "sql-exec steps require `sql` and `targetEnv`." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:sqlExec .
              FILTER (
                NOT EXISTS { $this impl:sql ?s }
                || NOT EXISTS { $this impl:targetEnv ?e }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "custom steps require exactly ONE of { command, fn } — having both or neither is a contract violation." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this impl:stepKind impl:custom .
              {
                # Neither present.
                FILTER NOT EXISTS { $this impl:command ?c1 }
                FILTER NOT EXISTS { $this impl:fn      ?f1 }
              } UNION {
                # Both present.
                $this impl:command ?c2 .
                $this impl:fn      ?f2 .
              }
            }
        """ ;
    ] .

# =====================================================================
# 7. Cross-cutting integrity invariants
# =====================================================================

impl:CrossCuttingShape
    a sh:NodeShape ;
    sh:targetClass cons:DecisionRef ;

    # stepId must start with parent decisionId + ".i"
    sh:sparql [
        sh:message "step.id must start with its parent decisionId (e.g. D-007.i1 belongs to D-007)." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this ?bad WHERE {
              $this cons:decisionId ?d ;
                    impl:hasImplementation/impl:hasStep ?st .
              ?st impl:stepId ?bad .
              FILTER (!STRSTARTS(?bad, CONCAT(?d, ".i")))
            }
        """ ;
    ] ;

    # `order` values within a single Implementation must be unique.
    sh:sparql [
        sh:message "Step `order` values must be unique within an Implementation." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this ?dup WHERE {
              $this impl:hasImplementation ?im .
              ?im   impl:hasStep ?s1 , ?s2 .
              FILTER (?s1 != ?s2)
              ?s1 impl:order ?dup .
              ?s2 impl:order ?dup .
            }
        """ ;
    ] ;

    # D4.3: `order` values must be contiguous starting at 1.
    # Future-proof choice: gaps in `order` are a sign of an incomplete
    # edit or a forgotten step. Insertions are cheap (renumber on save).
    # Allowing gaps now means the runner has to define "what does it mean
    # to skip from step 3 to step 7?" — there is no good answer.
    # Out-of-range catches order < 1 or > N. Gap detection is delegated
    # to the count check (D4.1): if order is in [1..N], unique (already
    # enforced above), and there are exactly N steps, the set is {1..N}.
    sh:sparql [
        sh:message "Step `order` values must lie in [1..declaredStepsCount]; combined with uniqueness and D4.1 count-check, this forces contiguous 1..N." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this ?o WHERE {
              $this impl:hasImplementation ?im .
              ?im impl:declaredStepsCount ?n ;
                  impl:hasStep ?s .
              ?s impl:order ?o .
              FILTER (?o < 1 || ?o > ?n)
            }
        """ ;
    ] ;

    # D4.1: declaredStepsCount must equal COUNT(hasStep). Catches
    # projector bugs where the YAML count and the materialised triples
    # diverge. Uses a nested SELECT that projects $this through so it
    # remains pre-bound for pyshacl's SHACL-SPARQL validator.
    sh:sparql [
        sh:message "declaredStepsCount must equal the actual number of hasStep triples on the Implementation." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this ?n ?actual WHERE {
              $this impl:hasImplementation ?im .
              ?im impl:declaredStepsCount ?n .
              {
                SELECT $this ?im (COUNT(?s) AS ?actual) WHERE {
                  $this impl:hasImplementation ?im .
                  OPTIONAL { ?im impl:hasStep ?s }
                } GROUP BY $this ?im
              }
              FILTER (?n != ?actual)
            }
        """ ;
    ] ;

    # D4.4: a Check used as a Step's postcondition MUST NOT write.
    # If your postcondition mutates state, you cannot use it to verify
    # the step's effect — the verification itself becomes the effect.
    sh:sparql [
        sh:message "impl:postcondition target must have cons:sideEffects in { none, reads } — postconditions cannot write." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this impl:hasImplementation/impl:hasStep ?st .
              ?st impl:postcondition ?check .
              ?check cons:sideEffects cons:writes .
            }
        """ ;
    ] ;

    # D4.6: drift-purity extended to Steps. A Step with sideEffects=writes
    # in runtime|infra context requires the parent Decision to carry at
    # least one Claim with cons:allowDestructive=true.
    sh:sparql [
        sh:message "A Step with sideEffects=writes in runtime|infra context requires a Claim on the same DecisionRef with allowDestructive=true." ;
        sh:select """
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this impl:hasImplementation/impl:hasStep ?st .
              ?st impl:sideEffects cons:writes ;
                  impl:context     ?ctx .
              FILTER (?ctx = cons:runtime || ?ctx = cons:infra)
              FILTER NOT EXISTS {
                $this cons:hasClaim ?cl .
                ?cl cons:allowDestructive true .
              }
            }
        """ ;
    ] .

# =====================================================================
# End of file
# =====================================================================
