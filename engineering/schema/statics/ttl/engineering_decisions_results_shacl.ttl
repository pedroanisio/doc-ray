# =====================================================================
# XAAI Lexicon Database — SHACL shapes for CHECK / STEP RESULTS.
#
# Target artefact:   the runner's results log
#                       (typically: results/<git-sha>/results.ttl
#                        or: results/$(date -I)/results.ttl)
# Companion shapes:  engineering_decisions.consequences.shacl.ttl
#                    engineering_decisions.implementation.shacl.ttl
#                    engineering_decisions.config.ttl
# Generated by:      Claude Opus 4.7 (1M context) via Claude Code
# Date:              2026-05-19
# Version:           1.0 (new in v2)
#
# DISCLAIMER (per CLAUDE.md):
#   No statement or premise not backed by a real logical definition or
#   verifiable reference should be taken for granted.
#
# MODEL INTENT:
#   The Consequences and Implementation shapes describe what SHOULD be
#   true. This shape describes what WAS observed — the runner's log of
#   actual check executions and step applications.
#
#     CheckResult --forCheck--> cons:Check
#     StepResult  --forStep-->  impl:Step
#
#   Each result records: when it ran, against which artefact hash,
#   outcome ∈ { pass, fail, error, skipped, not-applicable }, duration,
#   message. The validator can then enforce a freshness window: every
#   active check whose parent Decision has status=accepted must have a
#   recent passing CheckResult.
#
#   Freshness is a SOFT check: the SPARQL constraints below emit
#   sh:Warning severity by default, so they surface in reports without
#   blocking PRs. Promote to sh:Violation in your own profile if you
#   want hard enforcement.
#
# Validate with:
#       pyshacl -s engineering_decisions.results.shacl.ttl  \
#               -s engineering_decisions.config.ttl         \
#               -d /tmp/results.ttl                         \
#               -d /tmp/cons.ttl
# =====================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix res:     <https://xaai.ai/lexicon/decisions-results#> .
@prefix cons:    <https://xaai.ai/lexicon/consequences#> .
@prefix impl:    <https://xaai.ai/lexicon/implementation#> .
@prefix rec:     <https://xaai.ai/lexicon/decisions-record#> .
@prefix cfg:     <https://xaai.ai/lexicon/decisions-config#> .

# =====================================================================
# 1. Ontology header
# =====================================================================

res: a owl:Ontology ;
    dcterms:title    "XAAI Lexicon — Check & Step Results (SHACL)" ;
    dcterms:source   "results/<run-id>/results.ttl" ;
    dcterms:created  "2026-05-19"^^xsd:date ;
    dcterms:creator  "Claude Opus 4.7 (1M context) via Claude Code" ;
    owl:versionInfo  "1.0" ;
    rdfs:comment     "Shapes for the runner's results log; enables freshness checks against the consequences graph." .

# =====================================================================
# 2. Vocabulary — classes
# =====================================================================

res:CheckResult a rdfs:Class ;
    rdfs:label "Check execution result" .

res:StepResult a rdfs:Class ;
    rdfs:label "Step application result" .

res:Outcome a rdfs:Class .
res:pass          a res:Outcome .
res:fail          a res:Outcome .
res:error         a res:Outcome .
res:skipped       a res:Outcome .
res:notApplicable a res:Outcome .   # YAML literal: "not-applicable"

# =====================================================================
# 3. Vocabulary — properties
# =====================================================================

# Reference to the asserted artefact
res:forCheck          a rdf:Property ; rdfs:domain res:CheckResult ; rdfs:range cons:Check .
res:forStep           a rdf:Property ; rdfs:domain res:StepResult  ; rdfs:range impl:Step .

# Run metadata
res:resultId          a rdf:Property ; rdfs:range xsd:string .
res:runAt             a rdf:Property ; rdfs:range xsd:dateTime .
res:runByVersion      a rdf:Property ; rdfs:range xsd:string .
res:artefactHashAtRun a rdf:Property ; rdfs:range xsd:string .
res:outcome           a rdf:Property ; rdfs:range res:Outcome .
res:durationMs        a rdf:Property ; rdfs:range xsd:integer .
res:message           a rdf:Property ; rdfs:range xsd:string .
res:runner            a rdf:Property ; rdfs:range xsd:string .

# =====================================================================
# 4. CheckResult shape
# =====================================================================

res:CheckResultShape
    a sh:NodeShape ;
    sh:targetClass res:CheckResult ;

    sh:property [
        sh:path res:resultId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "resultId is required (e.g. ULID, UUID, or run-id.check-id pair)." ;
    ] ;
    sh:property [
        sh:path res:forCheck ;
        sh:class cons:Check ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every CheckResult must reference exactly one Check." ;
    ] ;
    sh:property [
        sh:path res:runAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "runAt (xsd:dateTime, UTC) is required." ;
    ] ;
    sh:property [
        sh:path res:runByVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "runByVersion (runner version string) is required for reproducibility." ;
    ] ;
    # Hash format:
    #   - Default: git short SHA (>=7 hex chars) or full SHA-1 (40 chars)
    #     of the working tree commit.
    #   - SHA-256 / longer hashes are allowed (max-length is unbounded).
    #   - Non-git artefact hashes are allowed as long as they're >=7 chars
    #     of hex (e.g. content hash of a generated artefact).
    # The regex enforces hex-only to prevent accidentally storing a
    # branch name, tag, or "HEAD" as a "hash".
    sh:property [
        sh:path res:artefactHashAtRun ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 7 ;
        sh:pattern "^[0-9a-f]+$" ;
        sh:message "artefactHashAtRun must be >=7 lowercase hex characters (git short/full SHA-1, SHA-256, or equivalent content hash)." ;
    ] ;
    sh:property [
        sh:path res:outcome ;
        sh:in ( res:pass res:fail res:error res:skipped res:notApplicable ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "outcome must be one of { pass, fail, error, skipped, not-applicable }." ;
    ] ;
    sh:property [
        sh:path res:durationMs ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path res:message ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    # fail / error outcomes require a non-empty message
    sh:sparql [
        sh:message "outcome=fail|error requires a non-empty `message` so the failure can be triaged." ;
        sh:select """
            PREFIX res: <https://xaai.ai/lexicon/decisions-results#>
            SELECT $this WHERE {
              $this res:outcome ?o .
              FILTER (?o = res:fail || ?o = res:error)
              FILTER NOT EXISTS { $this res:message ?m FILTER (STRLEN(STR(?m)) > 0) }
            }
        """ ;
    ] .

# =====================================================================
# 5. StepResult shape (parallel to CheckResult, for Implementation runs)
# =====================================================================

res:StepResultShape
    a sh:NodeShape ;
    sh:targetClass res:StepResult ;

    sh:property [
        sh:path res:resultId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path res:forStep ;
        sh:class impl:Step ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path res:runAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path res:artefactHashAtRun ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 7 ;
        sh:pattern "^[0-9a-f]+$" ;
        sh:message "artefactHashAtRun must be >=7 lowercase hex characters (same rule as CheckResult)." ;
    ] ;
    sh:property [
        sh:path res:outcome ;
        sh:in ( res:pass res:fail res:error res:skipped res:notApplicable ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

# =====================================================================
# 6. Freshness — every active check should have a recent result
#
#   "Active" = parent Decision has decisionStatus=accepted, and the
#   owning Claim has auditable=true, status=populated.
#
#   Freshness window is read from cfg:policy cfg:freshnessWindowDays at
#   validation time via SPARQL — no re-emission required. The SPARQL
#   constructs xsd:duration "P<N>D" from the integer policy value, so
#   swapping the project config swaps the window automatically.
#
#   Severity is sh:Warning by deliberate design (NOT a stub):
#     - A missing recent result usually means the runner has not run yet
#       in this branch/PR, not that the decision is broken.
#     - Promoting to Violation would block PRs that don't touch the
#       check at all, which would teach reviewers to ignore the report.
#   Projects that want hard enforcement can override the severity in a
#   downstream profile shape; the default is intentionally advisory.
# =====================================================================

# Freshness MISSING — Warning severity. Severity declared at NodeShape
# level because pyshacl does not honour sh:severity on inline sh:sparql
# blocks (the validator reports Violation regardless).
res:FreshnessShape
    a sh:NodeShape ;
    sh:targetClass cons:Check ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Active check has no fresh CheckResult within cfg:freshnessWindowDays." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX rec:  <https://xaai.ai/lexicon/decisions-record#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
              # The check belongs to an accepted, auditable, populated Claim.
              ?ref cons:hasClaim ?cl ;
                   cons:decisionId ?did .
              ?cl  cons:hasCheck $this ;
                   cons:auditable true ;
                   cons:status cons:populated .
              # Decision must be in `accepted` status (from the record graph).
              ?dec rec:id ?did ;
                   rec:decisionStatus rec:accepted .
              # Freshness window parametrised by the project policy.
              cfg:policy cfg:freshnessWindowDays ?days .
              BIND (STRDT(CONCAT("P", STR(?days), "D"), xsd:duration) AS ?window)
              # Either no result exists, or none within the window.
              FILTER NOT EXISTS {
                ?r res:forCheck $this ;
                   res:runAt ?t .
                FILTER (?t > (NOW() - ?window))
              }
            }
        """ ;
    ] .

# D5.3: An active check whose latest result is fail|error AND that
# result is still within the freshness window is a hard issue.
# A stale-and-failing check is already flagged by the warning above;
# double-counting it as a violation would punish runners that simply
# haven't re-run yet on this branch.
res:LatestFailShape
    a sh:NodeShape ;
    sh:targetClass cons:Check ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Active check's most recent (and still-fresh) result is fail or error." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX rec:  <https://xaai.ai/lexicon/decisions-record#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
              ?ref cons:hasClaim ?cl ;
                   cons:decisionId ?did .
              ?cl  cons:hasCheck $this ;
                   cons:auditable true ;
                   cons:status cons:populated .
              ?dec rec:id ?did ;
                   rec:decisionStatus rec:accepted .
              # Get the latest result for this check.
              ?r res:forCheck $this ;
                 res:runAt ?t ;
                 res:outcome ?o .
              FILTER (?o = res:fail || ?o = res:error)
              # No newer result exists.
              FILTER NOT EXISTS {
                ?r2 res:forCheck $this ;
                    res:runAt ?t2 .
                FILTER (?t2 > ?t)
              }
              # AND the failing result is itself still fresh (else the
              # freshness warning already covers it).
              cfg:policy cfg:freshnessWindowDays ?days .
              BIND (STRDT(CONCAT("P", STR(?days), "D"), xsd:duration) AS ?window)
              FILTER (?t > (NOW() - ?window))
            }
        """ ;
    ] .

# =====================================================================
# 7. StepResult freshness — parallel to CheckResult freshness
#
#   "Active" for Steps = parent Decision has rec:decisionStatus=accepted,
#   the owning Implementation has impl:status=populated, and the Step's
#   sideEffects are writes (a read-only step doesn't need re-application
#   tracking).
#
#   This catches the "did this step actually run on the current artefact
#   hash?" question that the Implementation half is supposed to answer.
# =====================================================================

res:StepFreshnessShape
    a sh:NodeShape ;
    sh:targetClass impl:Step ;
    sh:severity sh:Warning ;

    sh:sparql [
        sh:message "Active step (writes; accepted; populated) has no fresh StepResult within cfg:freshnessWindowDays." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX rec:  <https://xaai.ai/lexicon/decisions-record#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
              ?ref impl:hasImplementation ?im ;
                   cons:decisionId ?did .
              ?im  impl:hasStep $this ;
                   impl:status impl:populated .
              $this impl:sideEffects cons:writes .
              ?dec rec:id ?did ;
                   rec:decisionStatus rec:accepted .
              cfg:policy cfg:freshnessWindowDays ?days .
              BIND (STRDT(CONCAT("P", STR(?days), "D"), xsd:duration) AS ?window)
              FILTER NOT EXISTS {
                ?r res:forStep $this ;
                   res:runAt ?t .
                FILTER (?t > (NOW() - ?window))
              }
            }
        """ ;
    ] .

# Latest fresh step result is fail|error — hard issue.
res:StepLatestFailShape
    a sh:NodeShape ;
    sh:targetClass impl:Step ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Active step's most recent (and still-fresh) result is fail or error." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX rec:  <https://xaai.ai/lexicon/decisions-record#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
              ?ref impl:hasImplementation ?im ;
                   cons:decisionId ?did .
              ?im impl:hasStep $this ;
                  impl:status impl:populated .
              ?dec rec:id ?did ;
                   rec:decisionStatus rec:accepted .
              ?r res:forStep $this ;
                 res:runAt ?t ;
                 res:outcome ?o .
              FILTER (?o = res:fail || ?o = res:error)
              FILTER NOT EXISTS {
                ?r2 res:forStep $this ; res:runAt ?t2 .
                FILTER (?t2 > ?t)
              }
              cfg:policy cfg:freshnessWindowDays ?days .
              BIND (STRDT(CONCAT("P", STR(?days), "D"), xsd:duration) AS ?window)
              FILTER (?t > (NOW() - ?window))
            }
        """ ;
    ] .

# =====================================================================
# 8. Cross-graph integrity — result targets must resolve
#
#   forCheck / forStep are typed (sh:class) but rdflib treats absence of
#   the target class as conformance (no `a cons:Check` triple means no
#   shape is targeted on it). These SPARQL rules force the target to be
#   explicitly declared as the right class in the loaded graph.
# =====================================================================

res:TargetResolutionShape
    a sh:NodeShape ;
    sh:targetClass res:CheckResult ;
    sh:sparql [
        sh:message "res:forCheck target must be declared `a cons:Check` in the loaded graph (else the consequences graph wasn't supplied)." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this res:forCheck ?c .
              FILTER NOT EXISTS { ?c a cons:Check }
            }
        """ ;
    ] .

res:StepTargetResolutionShape
    a sh:NodeShape ;
    sh:targetClass res:StepResult ;
    sh:sparql [
        sh:message "res:forStep target must be declared `a impl:Step` in the loaded graph (else the implementation graph wasn't supplied)." ;
        sh:select """
            PREFIX res:  <https://xaai.ai/lexicon/decisions-results#>
            PREFIX impl: <https://xaai.ai/lexicon/implementation#>
            SELECT $this WHERE {
              $this res:forStep ?s .
              FILTER NOT EXISTS { ?s a impl:Step }
            }
        """ ;
    ] .

# =====================================================================
# End of file
# =====================================================================
