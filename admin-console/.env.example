# doc-ray Admin Console — environment overrides (all optional).
# Copy to .env and adjust for split/non-default deployments.

# Host port the console is published on (bound to 127.0.0.1).
ADMIN_CONSOLE_PORT=8080

# The shared docker network created by the main doc-ray compose project.
# Compose names it "<project>_default"; the main project is "doc-ray".
DOCRAY_NETWORK=doc-ray_default

# Upstreams the nginx front door proxies to. Defaults target the main stack's
# in-network service names; change only for split deployments.
ADMIN_API_UPSTREAM=http://api:8000
ADMIN_WEBAPP_UPSTREAM=http://webapp:5001
