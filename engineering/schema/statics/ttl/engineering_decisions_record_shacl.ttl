# =====================================================================
# XAAI Lexicon Database — SHACL shapes for the decisions RECORD itself.
#
# Target artefact:   engineering_decisions.yml (the canonical record)
# Companion shapes:  engineering_decisions.consequences.shacl.ttl
#                    engineering_decisions.implementation.shacl.ttl
#                    engineering_decisions.results.shacl.ttl
#                    engineering_decisions.config.ttl  (project-specific)
# Generated by:      Claude Opus 4.7 (1M context) via Claude Code
# Date:              2026-05-19
# Version:           2.0
#
# DISCLAIMER (per CLAUDE.md):
#   No statement or premise not backed by a real logical definition or
#   verifiable reference should be taken for granted.
#
# CHANGES FROM v1:
#   + Decision lifecycle:
#       rec:decisionStatus ∈ { proposed, accepted, deprecated,
#                              superseded, withdrawn }
#       + rec:decisionDate (xsd:date, required)
#       + rec:owner       (xsd:string, 1..N, required)
#   + Scope binding:
#       rec:scopePath (glob; 0..N) — which files the decision governs.
#   + Typed relationships (replace prose-only relation_to/companion_to):
#       rec:enables, rec:dependsOn, rec:clarifies, rec:conflictsWith,
#       rec:supersededBy — each typed as Decision -> Decision.
#       Prose fields relation_to/companion_to kept for back-compat.
#   + Withdrawal tombstone:
#       rec:withdrawnReason (xsd:string) — required when status=withdrawn.
#   - Inline category enum REMOVED (now in config.ttl).
#   - Inline anchor regex REMOVED (now in config.ttl).
#   - Contiguity rule REMOVED (incompatible with tombstones).
#   + Lifecycle interlocks:
#       status=superseded  ⇒ rec:supersededBy required, target != self
#       status=withdrawn   ⇒ rec:withdrawnReason required
#       status=proposed    ⇒ no inbound enables/dependsOn from accepted
#                            decisions (prevents forward references to
#                            unstable decisions)
#
# Validate with:
#       python3 scripts/yaml_to_rdf.py engineering_decisions.yml > /tmp/eng.ttl
#       pyshacl -s engineering_decisions.record.shacl.ttl \
#               -s engineering_decisions.config.ttl       \
#               -d /tmp/eng.ttl
# =====================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix rec:     <https://xaai.ai/lexicon/decisions-record#> .
@prefix d:       <https://xaai.ai/lexicon/schema-decisions/decision/> .

# =====================================================================
# 1. Ontology header
# =====================================================================

rec: a owl:Ontology ;
    dcterms:title    "XAAI Lexicon — Engineering Decisions Record (SHACL)" ;
    dcterms:source   "engineering_decisions.yml" ;
    dcterms:created  "2026-05-19"^^xsd:date ;
    dcterms:creator  "Claude Opus 4.7 (1M context) via Claude Code" ;
    owl:versionInfo  "2.0" ;
    rdfs:comment     "SHACL shapes for the YAML-as-record: well-formedness + lifecycle + scope + typed relations." .

# =====================================================================
# 2. Vocabulary — classes
# =====================================================================

rec:DecisionsRecord a rdfs:Class ;
    rdfs:label   "Decisions Record" ;
    rdfs:comment "The top-level document — corresponds to the YAML's root mapping." .

rec:Decision a rdfs:Class ;
    rdfs:label   "Decision (record entry)" ;
    rdfs:comment "One entry in the YAML's `decisions:` list." .

# Closed enums encoded as named individuals.
rec:DecisionStatus a rdfs:Class .
rec:proposed   a rec:DecisionStatus .
rec:accepted   a rec:DecisionStatus .
rec:deprecated a rec:DecisionStatus .
rec:superseded a rec:DecisionStatus .
rec:withdrawn  a rec:DecisionStatus .

# =====================================================================
# 3. Vocabulary — top-level record properties
# =====================================================================

rec:disclaimer          a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range xsd:string .
rec:sourceSchema        a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range xsd:string .
rec:sourceSchemaVersion a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range xsd:string .
rec:targetEngine        a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range xsd:string .
rec:hasDecision         a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range rec:Decision .
rec:totalDecisions      a rdf:Property ; rdfs:domain rec:DecisionsRecord ; rdfs:range xsd:integer .

# =====================================================================
# 4. Vocabulary — per-decision properties
# =====================================================================

# Required identity / metadata
rec:id                a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:title             a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:versionIntroduced a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:category          a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:decision          a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .

# Lifecycle (NEW in v2)
rec:decisionStatus    a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:DecisionStatus .
rec:decisionDate      a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:date .
rec:owner             a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:withdrawnReason   a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .

# Scope binding (NEW in v2)
rec:scopePath         a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string ;
    rdfs:comment "Glob (e.g. \"packages/**/*.ts\") of files this decision governs. 0..N." .

# Narrative / optional
rec:rationale         a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:implementation    a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:consequences      a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:future            a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:note              a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:caveat            a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:openIssue         a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:check             a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:mitigation        a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:linkage           a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:indexing          a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .

# Anchors (regex moved to config.ttl)
rec:schemaAnchor      a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:loaderAnchor      a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:pyprojectAnchor   a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .

# Legacy prose relations (kept for back-compat with v1 YAML)
rec:supersedes        a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:relationTo        a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .
rec:companionTo       a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range xsd:string .

# Typed relations (NEW in v2) — Decision -> Decision
rec:enables           a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .
rec:dependsOn         a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .
rec:clarifies         a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .
rec:conflictsWith     a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .
rec:supersededBy      a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .

# Computed cross-reference (union of all typed relations + parsed D-IDs
# from legacy prose). Materialised by scripts/yaml_to_rdf.py.
rec:references        a rdf:Property ; rdfs:domain rec:Decision ; rdfs:range rec:Decision .

# =====================================================================
# 5. Top-level shape — DecisionsRecord well-formedness
# =====================================================================

rec:DecisionsRecordShape
    a sh:NodeShape ;
    sh:targetClass rec:DecisionsRecord ;
    rdfs:label "Decisions record root" ;

    sh:property [
        sh:path rec:sourceSchema ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Record must declare source_schema." ;
    ] ;
    sh:property [
        sh:path rec:sourceSchemaVersion ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "source_schema_version must be SemVer (e.g. \"0.3.0\")." ;
    ] ;
    sh:property [
        sh:path rec:hasDecision ;
        sh:minCount 1 ;
        sh:message "Record must contain at least one decision." ;
    ] ;

    # IDs must be unique across the record (including withdrawn ones —
    # tombstones still occupy their slot).
    sh:sparql [
        sh:message "Duplicate decision id within the record." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this ?id WHERE {
              $this rec:hasDecision ?a , ?b .
              FILTER (?a != ?b)
              ?a rec:id ?id .
              ?b rec:id ?id .
            }
        """ ;
    ] .

# =====================================================================
# 6. Per-decision shape — required fields, types, patterns
# =====================================================================

rec:DecisionShape
    a sh:NodeShape ;
    sh:targetClass rec:Decision ;

    # --- id: D-001 .. D-999 -----------------------------------------
    # IDs are allocated monotonically and never reused. Gaps ARE allowed
    # (a withdrawn decision keeps its D-NNN slot as a tombstone; the next
    # decision takes the next free number, not the withdrawn one).
    # The contiguity rule was deliberately removed in v2 because
    # tombstones make it incompatible with sequential allocation in any
    # branch where decisions are added and withdrawn out of order.
    sh:property [
        sh:path rec:id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^D-[0-9]{3}$" ;
        sh:message "Decision id must match ^D-[0-9]{3}$ (e.g. \"D-007\"). Gaps are allowed; reuse is forbidden." ;
    ] ;

    # --- title: non-empty -------------------------------------------
    sh:property [
        sh:path rec:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Decision must have a non-empty title." ;
    ] ;

    # --- version_introduced: SemVer ---------------------------------
    sh:property [
        sh:path rec:versionIntroduced ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:message "version_introduced must be SemVer (e.g. \"0.3.0\")." ;
    ] ;

    # --- category: required string; closed-list enforcement lives in
    #     engineering_decisions.config.ttl ---------------------------
    sh:property [
        sh:path rec:category ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "category is required (closed-list values enforced by the project config)." ;
    ] ;

    # --- decision body ----------------------------------------------
    sh:property [
        sh:path rec:decision ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Decision must carry a non-empty `decision:` body." ;
    ] ;

    # --- decisionStatus: required, closed enum ----------------------
    sh:property [
        sh:path rec:decisionStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rec:proposed rec:accepted rec:deprecated rec:superseded rec:withdrawn ) ;
        sh:message "decisionStatus must be one of { proposed, accepted, deprecated, superseded, withdrawn }." ;
    ] ;

    # --- decisionDate: required xsd:date ----------------------------
    sh:property [
        sh:path rec:decisionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "decisionDate (ISO YYYY-MM-DD) is required for audit trail." ;
    ] ;

    # --- owner: required, at least one ------------------------------
    # Owner is an opaque string handle. Concrete handle-form validation
    # (email, GH login, team:slug, …) lives in the project's runner, not
    # here, so that the shapes stay reusable across orgs with different
    # identity conventions. We only enforce: present, >=3 chars, no
    # whitespace, no leading/trailing punctuation noise.
    sh:property [
        sh:path rec:owner ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:pattern "^\\S+$" ;
        sh:message "owner handles must be >=3 chars and contain no whitespace; semantic validation (email/GH login/team slug) is the runner's job." ;
    ] ;

    # --- scopePath: 0..N globs --------------------------------------
    sh:property [
        sh:path rec:scopePath ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "scopePath entries, if present, must be non-empty glob strings." ;
    ] ;

    # --- withdrawnReason: optional in general; interlock below requires
    #     it when decisionStatus=withdrawn ---------------------------
    sh:property [
        sh:path rec:withdrawnReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 8 ;
        sh:message "withdrawnReason, if present, must be a meaningful string (>=8 chars)." ;
    ] ;

    # --- Legacy prose relations (kept for back-compat) --------------
    sh:property [
        sh:path rec:supersedes ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 8 ;
        sh:message "supersedes (prose), if present, must be narrative; prefer rec:supersededBy for the typed link." ;
    ] ;
    sh:property [
        sh:path rec:companionTo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "D-[0-9]{3}" ;
        sh:message "companion_to (prose), if present, must mention at least one D-NNN; prefer rec:clarifies." ;
    ] ;
    sh:property [
        sh:path rec:relationTo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "D-[0-9]{3}" ;
        sh:message "relation_to (prose), if present, must mention at least one D-NNN; prefer typed relations." ;
    ] ;

    # --- Typed relations (NEW): each value must resolve to a Decision
    sh:property [
        sh:path rec:enables ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:message "rec:enables values must be Decision IRIs present in this record." ;
    ] ;
    sh:property [
        sh:path rec:dependsOn ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:message "rec:dependsOn values must be Decision IRIs present in this record." ;
    ] ;
    sh:property [
        sh:path rec:clarifies ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:message "rec:clarifies values must be Decision IRIs present in this record." ;
    ] ;
    sh:property [
        sh:path rec:conflictsWith ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:message "rec:conflictsWith values must be Decision IRIs present in this record." ;
    ] ;
    sh:property [
        sh:path rec:supersededBy ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "rec:supersededBy must reference at most one Decision IRI in this record." ;
    ] ;

    # --- Anchors: datatype only (regex moved to config.ttl) ---------
    sh:property [
        sh:path rec:schemaAnchor ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:loaderAnchor ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:pyprojectAnchor ;
        sh:datatype xsd:string ;
    ] ;

    # --- references: every cited Decision must resolve --------------
    sh:property [
        sh:path rec:references ;
        sh:class rec:Decision ;
        sh:nodeKind sh:IRI ;
        sh:message "Every D-NNN reference must resolve to a Decision in this record." ;
    ] .

# =====================================================================
# 7. Lifecycle interlocks (cross-cutting)
# =====================================================================

rec:LifecycleShape
    a sh:NodeShape ;
    sh:targetClass rec:Decision ;

    # status=superseded ⇒ supersededBy required, target != self
    sh:sparql [
        sh:message "status=superseded requires rec:supersededBy to point at another Decision (not self)." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this WHERE {
              $this rec:decisionStatus rec:superseded .
              FILTER (
                NOT EXISTS { $this rec:supersededBy ?t }
                || EXISTS  { $this rec:supersededBy $this }
              )
            }
        """ ;
    ] ;

    # status=withdrawn ⇒ withdrawnReason required
    sh:sparql [
        sh:message "status=withdrawn requires rec:withdrawnReason." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this WHERE {
              $this rec:decisionStatus rec:withdrawn .
              FILTER NOT EXISTS { $this rec:withdrawnReason ?r }
            }
        """ ;
    ] ;

    # No self-references via typed relations
    sh:sparql [
        sh:message "A decision must not appear in its own enables/dependsOn/clarifies/conflictsWith/supersededBy." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this WHERE {
              { $this rec:enables       $this }
              UNION
              { $this rec:dependsOn     $this }
              UNION
              { $this rec:clarifies     $this }
              UNION
              { $this rec:conflictsWith $this }
              UNION
              { $this rec:supersededBy  $this }
            }
        """ ;
    ] ;

    # No proposed decision may be depended on by an accepted one.
    sh:sparql [
        sh:message "An accepted decision cannot dependOn / enable a still-proposed decision (forward reference to unstable target)." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this ?target WHERE {
              $this rec:decisionStatus rec:accepted .
              { $this rec:dependsOn ?target } UNION { $this rec:enables ?target }
              ?target rec:decisionStatus rec:proposed .
            }
        """ ;
    ] ;

    # A withdrawn or superseded decision cannot itself enable / dependOn
    # an active decision (zombie reference).
    sh:sparql [
        sh:message "A withdrawn/superseded decision must not actively enable or dependOn other decisions." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this WHERE {
              $this rec:decisionStatus ?s .
              FILTER (?s = rec:withdrawn || ?s = rec:superseded)
              { $this rec:enables   ?t } UNION { $this rec:dependsOn ?t }
            }
        """ ;
    ] ;

    # D2.3: supersededBy target must itself be in an active-enough state.
    # Being superseded by a `proposed` or `withdrawn`/`superseded` decision
    # is a zombie pointer — the replacement is not actually live.
    sh:sparql [
        sh:message "rec:supersededBy target must have decisionStatus in { accepted, deprecated }." ;
        sh:select """
            PREFIX rec: <https://xaai.ai/lexicon/decisions-record#>
            SELECT $this WHERE {
              $this rec:supersededBy ?t .
              ?t rec:decisionStatus ?s .
              FILTER (?s != rec:accepted && ?s != rec:deprecated)
            }
        """ ;
    ] .

# =====================================================================
# End of file
# =====================================================================
