{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faz.ai/doc-ray/schema/backlog-1.0.0.json",
  "title": "doc-ray backlog / parking lot",
  "description": "Structure for the deferred-work backlog. Every item must trace to a real, verifiable source (a doc, an ADR decision id, a code path, or a recorded session finding). No time estimates: effort is expressed as complexity (XS..XL), per CLAUDE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["disclaimer", "metadata", "items"],
  "properties": {
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "description": "Epistemic-integrity notice, mirroring DISCLAIMER.md."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_by", "generated_on", "system_of_record", "total_items"],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the backlog schema this file targets."
        },
        "generated_by": {
          "type": "string",
          "description": "Model/tool that produced the document (AI-artifact labelling requirement)."
        },
        "generated_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO-8601 generation date (YYYY-MM-DD)."
        },
        "system_of_record": {
          "type": "string",
          "description": "Canonical path of this backlog within the repo."
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/backlogItem" }
    }
  },
  "$defs": {
    "backlogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "category", "type", "status", "complexity", "priority", "rationale", "source", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BL-[0-9]{3}$",
          "description": "Stable identifier, e.g. BL-001."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "description": "One-line statement of the item."
        },
        "description": {
          "type": "string",
          "description": "Fuller detail: the problem, the observed evidence, the proposed direction."
        },
        "category": {
          "type": "string",
          "enum": ["extraction", "webapp", "nlp", "api", "persistence", "security", "testing", "tooling", "ops", "docs"]
        },
        "type": {
          "type": "string",
          "enum": ["feature", "tech-debt", "bug", "infra", "research"]
        },
        "status": {
          "type": "string",
          "enum": ["parked", "ready", "blocked", "in-progress", "done"],
          "description": "Parking-lot default is 'parked'. 'ready' means scoped enough to start."
        },
        "complexity": {
          "type": "string",
          "enum": ["XS", "S", "M", "L", "XL"],
          "description": "Effort as complexity, not time (CLAUDE.md forbids time estimates)."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this matters / what breaks or is missed without it."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Verifiable done-conditions."
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
          "description": "Other backlog ids that must land first."
        },
        "related_decisions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^D-[0-9]{3}$" },
          "description": "engineering_decisions.yml decision ids this item realizes or touches."
        },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Repo paths, docs, or URLs that ground the item."
        },
        "owner": {
          "type": "string",
          "enum": ["mine", "concurrent", "shared", "unassigned"],
          "description": "Provenance boundary: which workstream authored/owns the affected code."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Where the item came from (doc, ADR, session finding) — traceability, not hearsay."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
