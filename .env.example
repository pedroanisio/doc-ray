# Copy to `.env` and adjust. docker-compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=docray
# Replace this before starting Compose; docker-compose rejects the historical
# default (`docray`) and placeholder values.
POSTGRES_PASSWORD=change-me-docray
POSTGRES_DB=docray
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Used by the ingester when run OUTSIDE docker (on the host) ---
DATABASE_URL=postgresql://docray:change-me-docray@localhost:5432/docray
S3_ENDPOINT=http://localhost:9000
# Overrides the migration directory the runner/entrypoints.migrate reads from
# (defaults to the packaged db/migrations); mainly a test/packaging hook.
# DOCRAY_MIGRATIONS_DIR=

# --- Optional PDF math extraction backend ---
# Set to `external` to route PDFs through a Docling/Marker/Nougat-style command
# that reads PDF bytes on stdin and emits verified JSON with LaTeX-bearing
# full_text on stdout. Invalid or non-LaTeX output is rejected before persistence.
DOCRAY_PDF_MATH_BACKEND=
DOCRAY_PDF_MATH_BACKEND_CMD=
DOCRAY_PDF_MATH_BACKEND_TIMEOUT=120

# --- Optional PDF OCR (image-only pages) ---
# Set to 1/true/yes/on to run PyMuPDF/Tesseract OCR when a PDF extracts to
# (near-)zero characters. DOCRAY_PDF_OCR_LANGUAGE is a Tesseract language code.
DOCRAY_PDF_OCR=
DOCRAY_PDF_OCR_LANGUAGE=eng

# --- PDF heading-detection calibration ---
# Font-size ratio (vs. body text) above which a line is treated as an H1/H2/H3
# heading, and the word count above which a bold line stops being treated as a
# heading candidate. Defaults match domain/pdf_layout.py's HeadingThresholds.
DOCRAY_PDF_HEADING_L1_RATIO=1.5
DOCRAY_PDF_HEADING_L2_RATIO=1.25
DOCRAY_PDF_HEADING_L3_RATIO=1.1
DOCRAY_PDF_HEADING_BOLD_MAX_WORDS=10

# --- EPUB/DOCX extraction hardening ---
# Both formats are zip containers; a small compressed upload could otherwise
# declare an arbitrarily large uncompressed payload (a decompression bomb).
# Rejected before any XML parsing begins. Default 500 MiB.
DOCRAY_EXTRACT_MAX_UNCOMPRESSED_MB=500

# --- spaCy annotation ---
# "fail" (default) aborts the annotate job if the document's language has no
# installed spaCy model; "fallback" degrades to a default model instead.
DOCRAY_SPACY_FALLBACK_POLICY=fail

# --- Frontier resolver (entity-resolution LLM calls, opt-in/explicit only) ---
# DOCRAY_RESOLVER_MODEL=claude-opus-4-8

# --- GraphQL API ---
DOCRAY_API_POOL_MIN_SIZE=1
DOCRAY_API_POOL_MAX_SIZE=10
DOCRAY_API_POOL_TIMEOUT=10
# Postgres statement_timeout (ms) applied to every pooled connection, so one
# unbounded query (e.g. a corpus-wide aggregation) fails fast instead of
# monopolizing a backend indefinitely.
DOCRAY_API_STATEMENT_TIMEOUT_MS=15000
# Query-safety caps (schema.py) — max GraphQL query nesting depth and max
# token/complexity count. Defaults: 12 and 2000.
API_MAX_DEPTH=12
API_MAX_TOKENS=2000
# token=principal_uuid[:scope+scope], entries separated by comma or semicolon.
# Leave empty for local anonymous access scoped by database RLS.
DOCRAY_API_TOKENS=
DOCRAY_API_ALLOW_ANONYMOUS=true
# GraphQL introspection + the interactive GraphiQL IDE are disabled unless this
# is set — an anonymous caller (the default above) should not be able to
# enumerate the schema, including admin-only mutation shapes, for free
# reconnaissance. Set true only for local development.
DOCRAY_API_DEBUG=
# GraphQL endpoint the webapp posts mutations to (entrypoints.api service URL).
DOCRAY_API_URL=http://localhost:8000/graphql

# --- Scheduled backups and ops monitors ---
DOCRAY_BACKUP_SCHEDULE_SECONDS=86400
DOCRAY_BACKUP_RETENTION_COUNT=7
DOCRAY_BACKUP_RETENTION_DAYS=30
DOCRAY_DB_HEALTH_INTERVAL_SECONDS=300

# --- Worker (entrypoints.worker) ---
# Seconds between claim attempts when the queue is empty; heartbeat interval
# while a job runs; how long a missed heartbeat is tolerated before a job is
# reclaimed as stale. Defaults: 5, 15, 120.
WORKER_POLL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_CLAIM_TIMEOUT_SECONDS=120

# --- Webapp (webapp/app.py) ---
# Flask port for `python -m webapp.app` (ignored under `flask run --port`).
PORT=5001
# Caps upload size in MB before it's fully buffered for hashing — enforced by
# both the webapp's Flask route and the GraphQL ingestDocument mutation (BL-098).
DOCRAY_MAX_UPLOAD_MB=200
# Bearer token required to view /operator/health; unset hides the page (404).
# DOCRAY_OPERATOR_HEALTH_TOKEN=

# --- Access control (webapp RLS enforcement — see db/migrations/018_rbac.sql) ---
# Leave DOCRAY_PRINCIPAL_ID unset for local/dev: the webapp connects as the
# superuser and RLS is bypassed (sees everything). To enforce document-level
# access, set it to a row from `principals.id`; the webapp then SET ROLE
# docray_client and stamps that principal, so only permitted documents are visible.
# DOCRAY_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
# DOCRAY_DB_ROLE=docray_client

# --- Webapp -> API write auth ---
# The webapp's own DB connection (above) only scopes its direct, read-only
# Postgres queries. Every WRITE goes over HTTP to the GraphQL API instead, and
# that API requires a write-scoped principal (entrypoints/api/mutation.py
# `_require_write`) — anonymous callers are always read-only regardless of
# DOCRAY_API_ALLOW_ANONYMOUS. Set this to one of the tokens listed in
# DOCRAY_API_TOKENS above so the webapp can call ingestDocument/reannotate/etc.
# DOCRAY_WEBAPP_API_TOKEN=
