# =====================================================================
# XAAI Lexicon Database — SHACL shapes for the WITH-CONSEQUENCES YAML.
#
# Target artefact:   engineering_decisions.with_consequences.yml
# Companion shapes:  engineering_decisions.record.shacl.ttl
#                    engineering_decisions.implementation.shacl.ttl
#                    engineering_decisions.results.shacl.ttl
#                    engineering_decisions.config.ttl
# Generated by:      Claude Opus 4.7 (1M context) via Claude Code
# Date:              2026-05-19
# Version:           2.0
#
# DISCLAIMER (per CLAUDE.md):
#   No statement or premise not backed by a real logical definition or
#   verifiable reference should be taken for granted.
#
# CHANGES FROM v1:
#   + Claim grouping:
#       DecisionRef --hasClaim--> Claim --hasCheck--> Check
#       (instead of the old DecisionRef --hasConsequences--> ... model).
#       Each Claim is independently auditable; a decision may carry many.
#   + Severity gains an `info` tier (advisory; never blocks).
#   + Check.context ∈ { workspace, ci, runtime, infra } — required.
#   + Check.sideEffects ∈ { none, reads, writes } — required for
#     `shell` and `python-call`, optional elsewhere (default `none`).
#   + Check.timeoutMs   — optional positive integer (runner hint).
#   + Check.retries     — optional non-negative integer (runner hint).
#   + Drift-purity interlock: any check with sideEffects=writes is
#     forbidden under context=runtime|infra unless the parent Claim
#     explicitly declares allowDestructive=true.
#
# MIGRATION FROM v1:
#   The v1 model had one Consequences block per Decision, with
#   auditable/status/checks as direct properties of Consequences. The
#   v2 projector materialises ONE default Claim per legacy block,
#   moving those properties into it. New YAML may declare multiple
#   Claims directly.
#
#   Validate with:
#       python3 scripts/consequences_to_rdf.py engineering_decisions.with_consequences.yml > /tmp/cons.ttl
#       pyshacl -s engineering_decisions.consequences.shacl.ttl \
#               -s engineering_decisions.config.ttl              \
#               -d /tmp/cons.ttl
# =====================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix cons:    <https://xaai.ai/lexicon/consequences#> .

# =====================================================================
# 1. Ontology header
# =====================================================================

cons: a owl:Ontology ;
    dcterms:title    "XAAI Lexicon — Auditable Consequences (SHACL)" ;
    dcterms:source   "engineering_decisions.with_consequences.yml" ;
    dcterms:created  "2026-05-19"^^xsd:date ;
    dcterms:creator  "Claude Opus 4.7 (1M context) via Claude Code" ;
    owl:versionInfo  "2.0" ;
    rdfs:comment     "Shapes for the Consequences-and-Checks vocabulary with multi-Claim grouping." .

# =====================================================================
# 2. Vocabulary — classes
# =====================================================================

cons:DecisionRef a rdfs:Class ;
    rdfs:label "Decision reference (id-only handle into the main YAML)" .

cons:Claim a rdfs:Class ;
    rdfs:label "Claim (one assertable consequence of a Decision)" ;
    rdfs:comment "A Decision may carry multiple Claims; each is independently auditable." .

cons:Check a rdfs:Class ;
    rdfs:label "Check (one runnable assertion within a Claim)" .

# Status enum (per-Claim)
cons:Status a rdfs:Class .
cons:populated    a cons:Status .
cons:pending      a cons:Status .
cons:judgmentOnly a cons:Status .   # YAML literal: "judgment-only"
cons:subsumed     a cons:Status .

# Severity enum (NEW: + info)
#
#   Severity is DATA, not a SHACL contract. It tells the runner how to
#   treat a check's outcome — it does NOT change validation behaviour.
#
#     error   — failing this check fails the audit (default).
#     warning — failing surfaces in the report but does not block CI.
#     info    — advisory; pure telemetry. The runner SHOULD never fail a
#               PR on an `info` outcome. The contract that `info` never
#               blocks lives in the runner spec, NOT in this graph.
#
#   See: docs/runner-spec.md (Severity dispatch table) for the exact
#   exit-code mapping the runner is required to implement.
cons:Severity a rdfs:Class .
cons:error    a cons:Severity .
cons:warning  a cons:Severity .
cons:info     a cons:Severity .

# Execution context enum (NEW)
cons:Context  a rdfs:Class .
cons:workspace a cons:Context .   # local checkout / dev box
cons:ci        a cons:Context .   # CI pipeline
cons:runtime   a cons:Context .   # live application
cons:infra     a cons:Context .   # cloud / infra plane

# Side-effects enum (NEW)
cons:SideEffects a rdfs:Class .
cons:noEffect a cons:SideEffects .  # YAML literal: "none"
cons:reads    a cons:SideEffects .
cons:writes   a cons:SideEffects .

# CheckKind enum (unchanged set of 10)
cons:CheckKind      a rdfs:Class .
cons:sql            a cons:CheckKind .
cons:sqlRaises      a cons:CheckKind .   # YAML literal: "sql-raises"
cons:grep           a cons:CheckKind .
cons:fileExists     a cons:CheckKind .   # YAML literal: "file-exists"
cons:tomlKey        a cons:CheckKind .   # YAML literal: "toml-key"
cons:fileHashEquals a cons:CheckKind .   # YAML literal: "file-hash-equals"
cons:pythonCall     a cons:CheckKind .   # YAML literal: "python-call"
cons:shell          a cons:CheckKind .
cons:crossArtifact  a cons:CheckKind .   # YAML literal: "cross-artifact"
cons:crossToml      a cons:CheckKind .   # YAML literal: "cross-toml"

# =====================================================================
# 3. Vocabulary — properties
# =====================================================================

# DecisionRef -> Claim (1..N)
cons:hasClaim       a rdf:Property ; rdfs:domain cons:DecisionRef ; rdfs:range cons:Claim .
cons:decisionId     a rdf:Property ; rdfs:domain cons:DecisionRef ; rdfs:range xsd:string .

# Claim fields
cons:claimId        a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:string .
cons:claimText      a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:string .
cons:auditable      a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:boolean .
cons:status         a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range cons:Status .
cons:reason         a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:string .
cons:hasCheck       a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range cons:Check .
cons:declaredChecksCount a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:integer .
# Claim-level opt-in for destructive runtime/infra checks.
cons:allowDestructive a rdf:Property ; rdfs:domain cons:Claim ; rdfs:range xsd:boolean .

# Check core fields
cons:checkId        a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:string .
cons:description    a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:string .
cons:checkKind      a rdf:Property ; rdfs:domain cons:Check ; rdfs:range cons:CheckKind .
cons:severity       a rdf:Property ; rdfs:domain cons:Check ; rdfs:range cons:Severity .
cons:rationale      a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:string .
cons:requiresSeed   a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:boolean .

# Check execution metadata (NEW in v2)
cons:context        a rdf:Property ; rdfs:domain cons:Check ; rdfs:range cons:Context .
cons:sideEffects    a rdf:Property ; rdfs:domain cons:Check ; rdfs:range cons:SideEffects .
cons:timeoutMs      a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:integer .
cons:retries        a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:integer .
cons:targetEnv      a rdf:Property ; rdfs:domain cons:Check ; rdfs:range xsd:string .  # which DB / which cluster

# Check kind-specific payload fields (unchanged set)
cons:query          a rdf:Property ; rdfs:range xsd:string .
cons:setup          a rdf:Property ; rdfs:range xsd:string .
cons:path           a rdf:Property ; rdfs:range xsd:string .
cons:pattern        a rdf:Property ; rdfs:range xsd:string .
cons:key            a rdf:Property ; rdfs:range xsd:string .
cons:command        a rdf:Property ; rdfs:range xsd:string .
cons:fn             a rdf:Property ; rdfs:range xsd:string .
cons:args           a rdf:Property ; rdfs:range rdf:List .
cons:returns        a rdf:Property ; rdfs:range xsd:string .
cons:queryDb        a rdf:Property ; rdfs:range xsd:string .
cons:grepFile       a rdf:Property ; rdfs:range xsd:string .
cons:grepPattern    a rdf:Property ; rdfs:range xsd:string .
cons:relation       a rdf:Property ; rdfs:range xsd:string .
cons:assertText     a rdf:Property ; rdfs:range xsd:string .
cons:leftPath       a rdf:Property ; rdfs:range xsd:string .
cons:rightPath      a rdf:Property ; rdfs:range xsd:string .

# Expect block fields
cons:expectRows         a rdf:Property ; rdfs:range xsd:integer .
cons:expectRowsGte      a rdf:Property ; rdfs:range xsd:integer .
cons:expectRowEquals    a rdf:Property ; rdfs:range xsd:string .
cons:expectRowGte       a rdf:Property ; rdfs:range xsd:string .
cons:expectRowNotEquals a rdf:Property ; rdfs:range xsd:string .
cons:expectSqlstate     a rdf:Property ; rdfs:range xsd:string .
cons:expectPresent      a rdf:Property ; rdfs:range xsd:boolean .
cons:expectCount        a rdf:Property ; rdfs:range xsd:integer .
cons:expectCountGte     a rdf:Property ; rdfs:range xsd:integer .
cons:expectEquals       a rdf:Property ; rdfs:range xsd:string .
cons:expectContains     a rdf:Property ; rdfs:range xsd:string .
cons:expectHash         a rdf:Property ; rdfs:range xsd:string .
cons:expectExit         a rdf:Property ; rdfs:range xsd:integer .

# =====================================================================
# 4. DecisionRef shape — one wrapper per decision, hasClaim 1..N
# =====================================================================

cons:DecisionRefShape
    a sh:NodeShape ;
    sh:targetClass cons:DecisionRef ;
    sh:property [
        sh:path cons:decisionId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^D-[0-9]{3}$" ;
        sh:message "decisionId must match ^D-[0-9]{3}$ (e.g. \"D-011\")." ;
    ] ;
    sh:property [
        sh:path cons:hasClaim ;
        sh:class cons:Claim ;
        sh:minCount 1 ;
        sh:message "Every DecisionRef must carry at least one Claim (use auditable=false / status=judgmentOnly for non-auditable claims)." ;
    ] .

# =====================================================================
# 5. Claim shape — state interlock
# =====================================================================

cons:ClaimShape
    a sh:NodeShape ;
    sh:targetClass cons:Claim ;

    sh:property [
        sh:path cons:claimId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^D-[0-9]{3}\\.k[0-9]+$" ;
        sh:message "claimId must match ^D-NNN.kN$ (e.g. \"D-011.k1\")." ;
    ] ;
    sh:property [
        sh:path cons:claimText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 8 ;
        sh:message "Every Claim must declare its claimText (>=8 chars) — what is being asserted." ;
    ] ;
    sh:property [
        sh:path cons:auditable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Claim must declare `auditable` as a boolean." ;
    ] ;
    sh:property [
        sh:path cons:status ;
        sh:in ( cons:populated cons:pending cons:judgmentOnly cons:subsumed ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "status must be one of { populated, pending, judgment-only, subsumed }." ;
    ] ;
    sh:property [
        sh:path cons:reason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cons:declaredChecksCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "declaredChecksCount records len(checks) verbatim from the YAML." ;
    ] ;
    sh:property [
        sh:path cons:allowDestructive ;
        sh:datatype xsd:boolean ;
        sh:minCount 0 ; sh:maxCount 1 ;
        sh:message "allowDestructive, if present, must be a single boolean." ;
    ] ;

    # ---- State interlocks ------------------------------------------
    sh:sparql [
        sh:message "auditable=false requires a non-empty `reason` and forbids any `checks`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:auditable false .
              FILTER (
                NOT EXISTS { $this cons:reason ?r }
                || EXISTS { $this cons:hasCheck ?c }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "auditable=false requires status in { judgment-only, subsumed }." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:auditable false .
              $this cons:status ?s .
              FILTER (?s != cons:judgmentOnly && ?s != cons:subsumed)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "status=populated requires at least one check." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:status cons:populated .
              FILTER NOT EXISTS { $this cons:hasCheck ?c }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "status=pending requires checks to be an explicit empty list (declaredChecksCount=0, no hasCheck)." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:status cons:pending .
              FILTER (
                EXISTS { $this cons:hasCheck ?c }
                || NOT EXISTS { $this cons:declaredChecksCount 0 }
              )
            }
        """ ;
    ] .

# =====================================================================
# 6. Check shape — common fields, then per-kind required fields
# =====================================================================

cons:CheckShape
    a sh:NodeShape ;
    sh:targetClass cons:Check ;

    sh:property [
        sh:path cons:checkId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^D-[0-9]{3}\\.k[0-9]+\\.c[0-9]+$" ;
        sh:message "check.id must match ^D-NNN.kN.cN$ (e.g. \"D-011.k1.c3\")." ;
    ] ;
    sh:property [
        sh:path cons:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 8 ;
        sh:message "Every check must carry a non-empty description." ;
    ] ;
    sh:property [
        sh:path cons:checkKind ;
        sh:in (
            cons:sql cons:sqlRaises cons:grep cons:fileExists cons:tomlKey
            cons:fileHashEquals cons:pythonCall cons:shell
            cons:crossArtifact cons:crossToml
        ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "checkKind must be one of the ten documented kinds." ;
    ] ;
    sh:property [
        sh:path cons:severity ;
        sh:in ( cons:error cons:warning cons:info ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "severity must be one of { error, warning, info }." ;
    ] ;
    sh:property [
        sh:path cons:context ;
        sh:in ( cons:workspace cons:ci cons:runtime cons:infra ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "context must be one of { workspace, ci, runtime, infra }." ;
    ] ;
    sh:property [
        sh:path cons:sideEffects ;
        sh:in ( cons:noEffect cons:reads cons:writes ) ;
        sh:maxCount 1 ;
        sh:message "sideEffects, if present, must be one of { none, reads, writes }." ;
    ] ;
    sh:property [
        sh:path cons:timeoutMs ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:message "timeoutMs, if present, must be a positive integer." ;
    ] ;
    sh:property [
        sh:path cons:retries ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "retries, if present, must be a non-negative integer." ;
    ] ;

    # ---- shell / python-call MUST declare sideEffects when policy is strict
    #      (cfg:strictSideEffectsOnShell = true). When the policy flag is
    #      false, absent sideEffects defaults to cons:noEffect downstream.
    sh:sparql [
        sh:message "shell checks must declare cons:sideEffects explicitly (none | reads | writes) when cfg:strictSideEffectsOnShell=true." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            SELECT $this WHERE {
              cfg:policy cfg:strictSideEffectsOnShell true .
              $this cons:checkKind cons:shell .
              FILTER NOT EXISTS { $this cons:sideEffects ?s }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "python-call checks must declare cons:sideEffects explicitly (none | reads | writes) when cfg:strictSideEffectsOnShell=true." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            SELECT $this WHERE {
              cfg:policy cfg:strictSideEffectsOnShell true .
              $this cons:checkKind cons:pythonCall .
              FILTER NOT EXISTS { $this cons:sideEffects ?s }
            }
        """ ;
    ] ;

    # ---- D3.2: context must be an allowed dispatch target (per cfg:policy)
    sh:sparql [
        sh:message "cons:Check has a context that is not in cfg:policy/cfg:allowedCheckContexts; the runner will refuse to dispatch it." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            PREFIX cfg:  <https://xaai.ai/lexicon/decisions-config#>
            SELECT $this WHERE {
              $this cons:context ?ctx .
              FILTER NOT EXISTS { cfg:policy cfg:allowedCheckContexts ?ctx }
            }
        """ ;
    ] ;

    # ---- Per-kind required-field SPARQL guards ----------------------
    sh:sparql [
        sh:message "sql checks require `query` and at least one expect: { rows | rowsGte | rowEquals | rowGte | rowNotEquals }." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:sql .
              FILTER (
                NOT EXISTS { $this cons:query ?q }
                || (
                  NOT EXISTS { $this cons:expectRows ?a }
                  && NOT EXISTS { $this cons:expectRowsGte ?b }
                  && NOT EXISTS { $this cons:expectRowEquals ?c }
                  && NOT EXISTS { $this cons:expectRowGte ?d }
                  && NOT EXISTS { $this cons:expectRowNotEquals ?e }
                )
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "sql-raises checks require `query` and `expectSqlstate`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:sqlRaises .
              FILTER (
                NOT EXISTS { $this cons:query ?q }
                || NOT EXISTS { $this cons:expectSqlstate ?s }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "grep checks require `path`, `pattern`, and an expect block." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:grep .
              FILTER (
                NOT EXISTS { $this cons:path ?p }
                || NOT EXISTS { $this cons:pattern ?pat }
                || (
                  NOT EXISTS { $this cons:expectPresent ?a }
                  && NOT EXISTS { $this cons:expectCount ?b }
                  && NOT EXISTS { $this cons:expectCountGte ?c }
                )
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "file-exists checks require `path` and `expectPresent`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:fileExists .
              FILTER (
                NOT EXISTS { $this cons:path ?p }
                || NOT EXISTS { $this cons:expectPresent ?e }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "toml-key checks require `key` and an expect block." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:tomlKey .
              FILTER (
                NOT EXISTS { $this cons:key ?k }
                || (
                  NOT EXISTS { $this cons:expectPresent ?a }
                  && NOT EXISTS { $this cons:expectEquals ?b }
                  && NOT EXISTS { $this cons:expectContains ?c }
                )
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "file-hash-equals checks require `path` and `expectHash`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:fileHashEquals .
              FILTER (
                NOT EXISTS { $this cons:path ?p }
                || NOT EXISTS { $this cons:expectHash ?h }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "python-call checks require `fn` and `returns`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:pythonCall .
              FILTER (
                NOT EXISTS { $this cons:fn ?f }
                || NOT EXISTS { $this cons:returns ?r }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "shell checks require `command` and `expectExit`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:shell .
              FILTER (
                NOT EXISTS { $this cons:command ?c }
                || NOT EXISTS { $this cons:expectExit ?x }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "cross-artifact checks require `assertText`, `queryDb`, `grepFile`, `grepPattern`, and `relation`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:crossArtifact .
              FILTER (
                NOT EXISTS { $this cons:assertText ?a }
                || NOT EXISTS { $this cons:queryDb ?q }
                || NOT EXISTS { $this cons:grepFile ?f }
                || NOT EXISTS { $this cons:grepPattern ?p }
                || NOT EXISTS { $this cons:relation ?r }
              )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "cross-toml checks require `leftPath`, `rightPath`, and `relation`." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:checkKind cons:crossToml .
              FILTER (
                NOT EXISTS { $this cons:leftPath ?l }
                || NOT EXISTS { $this cons:rightPath ?r }
                || NOT EXISTS { $this cons:relation ?rel }
              )
            }
        """ ;
    ] .

# =====================================================================
# 7. Cross-cutting integrity invariants
# =====================================================================

cons:CrossCuttingShape
    a sh:NodeShape ;
    sh:targetClass cons:DecisionRef ;

    # claimId must start with parent decisionId + ".k"
    sh:sparql [
        sh:message "claim.id must start with its parent decisionId (e.g. D-011.k1 belongs to D-011)." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this ?bad WHERE {
              $this cons:decisionId ?d ;
                    cons:hasClaim ?cl .
              ?cl cons:claimId ?bad .
              FILTER (!STRSTARTS(?bad, CONCAT(?d, ".k")))
            }
        """ ;
    ] ;

    # checkId must start with parent claimId + ".c"
    sh:sparql [
        sh:message "check.id must start with its parent claimId (e.g. D-011.k1.c3 belongs to claim D-011.k1)." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:hasClaim/cons:hasCheck ?ck .
              $this cons:hasClaim ?cl .
              ?cl cons:hasCheck ?ck ;
                  cons:claimId   ?kid .
              ?ck cons:checkId   ?bad .
              FILTER (!STRSTARTS(?bad, CONCAT(?kid, ".c")))
            }
        """ ;
    ] ;

    # Writes-into-prod safety net: sideEffects=writes is forbidden under
    # runtime|infra unless the parent Claim opts in via allowDestructive=true.
    sh:sparql [
        sh:message "A check with sideEffects=writes in runtime|infra context requires its Claim to set allowDestructive=true." ;
        sh:select """
            PREFIX cons: <https://xaai.ai/lexicon/consequences#>
            SELECT $this WHERE {
              $this cons:hasClaim ?cl .
              ?cl  cons:hasCheck  ?ck .
              ?ck  cons:sideEffects cons:writes ;
                   cons:context     ?ctx .
              FILTER (?ctx = cons:runtime || ?ctx = cons:infra)
              FILTER NOT EXISTS { ?cl cons:allowDestructive true }
            }
        """ ;
    ] .

# =====================================================================
# End of file
