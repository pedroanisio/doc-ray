# Copy to `.env.test` for the isolated Docker test stack.
# Do not reuse `.env`: the test stack has its own project, containers, ports,
# volumes, database, and bucket so it cannot mutate the current UAT stack.

TEST_POSTGRES_USER=docray_test
TEST_POSTGRES_PASSWORD=change-me-docray-test
TEST_POSTGRES_DB=docray_test
TEST_POSTGRES_PORT=15432

TEST_S3_ACCESS_KEY=minioadmin
TEST_S3_SECRET_KEY=minioadmin
TEST_S3_BUCKET=documents-test
TEST_MINIO_PORT=19000
TEST_MINIO_CONSOLE_PORT=19001

# Override only when you want a narrower Dockerized pytest run, for example:
# TEST_PYTEST_ARGS=tests/test_compose_security.py -q
TEST_PYTEST_ARGS=
