# Copy to `.env` and adjust. docker-compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=docray
POSTGRES_PASSWORD=docray
POSTGRES_DB=docray
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Used by the ingester when run OUTSIDE docker (on the host) ---
DATABASE_URL=postgresql://docray:docray@localhost:5432/docray
S3_ENDPOINT=http://localhost:9000

# --- Access control (webapp RLS enforcement — see db/migrations/018_rbac.sql) ---
# Leave DOCRAY_PRINCIPAL_ID unset for local/dev: the webapp connects as the
# superuser and RLS is bypassed (sees everything). To enforce document-level
# access, set it to a row from `principals.id`; the webapp then SET ROLE
# docray_client and stamps that principal, so only permitted documents are visible.
# DOCRAY_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
# DOCRAY_DB_ROLE=docray_client
