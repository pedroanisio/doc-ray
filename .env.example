# GENERATED FILE — do not edit by hand.
# Source of truth: config/env.registry.yaml
# Regenerate: python scripts/gen_env_samples.py

# doc-ray DEVELOPMENT environment sample. Copy to .env for local work.
# Defaults below target the local compose stack (Postgres + MinIO).

# ===== Database ==========

# Postgres connection string for the corpus database. Local dev points at the
# compose stack; production points at the managed cluster (set in .env.prod
# only).
DATABASE_URL=postgresql://docray:docray@localhost:5432/docray

# Maximum size of the API's Postgres connection pool.
DOCRAY_API_POOL_MAX_SIZE=10

# Minimum number of connections the API keeps open in its Postgres pool.
DOCRAY_API_POOL_MIN_SIZE=1

# Seconds a request waits for a free pooled connection before erroring.
DOCRAY_API_POOL_TIMEOUT=10.0

# Postgres statement_timeout (ms) applied to every pooled connection, so one
# unbounded query (e.g. a corpus-wide aggregation) fails fast instead of
# monopolizing a backend indefinitely.
DOCRAY_API_STATEMENT_TIMEOUT_MS=15000

# Non-superuser Postgres role the API/webapp connect as, so per-principal row-
# level security applies. The webapp refuses to boot on a mismatch.
DOCRAY_DB_ROLE=docray_client

# Database name the compose postgres service creates on first boot. Consumed by
# docker-compose, not read by application code.
POSTGRES_DB=docray

# Superuser password for the compose postgres service. The container entrypoint
# refuses to start with an unset or default value ("docray"/"change-me"), so
# this placeholder forces operators to pick a real secret. Consumed by docker-
# compose, not read by application code.
POSTGRES_PASSWORD=change-me

# Loopback host port the compose postgres service publishes (127.0.0.1 only).
# Consumed by docker-compose, not read by application code.
POSTGRES_PORT=5432

# Superuser role name for the compose postgres service. Consumed by docker-
# compose, not read by application code.
POSTGRES_USER=docray

# ===== Object store (S3 / Spaces / MinIO) ==========

# Standard AWS SDK access-key fallback, read when S3_ACCESS_KEY is unset (boto
# default chain).
# AWS_ACCESS_KEY_ID=

# Standard AWS SDK secret-key fallback, read when S3_SECRET_KEY is unset.
# AWS_SECRET_ACCESS_KEY=

# Bucket the on-demand source ingester scans for new documents.
DOCRAY_SOURCE_BUCKET=doc-ray-dev

# Object-store endpoint the on-demand source ingester reads uploads from.
# DOCRAY_SOURCE_ENDPOINT=

# Login email of the principal that owns documents loaded by the source
# ingester; unset means unowned (admin-only).
# DOCRAY_SOURCE_OWNER_EMAIL=

# Region of the source-ingest bucket.
DOCRAY_SOURCE_REGION=sfo3

# Local path where the source ingester records which objects it has already
# processed. Unset, it derives one manifest per source bucket (.ingest-
# state/<bucket>.json) so two buckets cannot mask each other's object keys.
DOCRAY_SOURCE_STATE=

# Object-store access key (MinIO locally, Spaces in production).
S3_ACCESS_KEY=minioadmin

# Local MinIO uses plaintext HTTP. Keep this unset/0 for non-local object
# stores.
S3_ALLOW_INSECURE_ENDPOINT=false

# Bucket holding content-addressed original document bytes and backup archives.
S3_BUCKET=documents

# Object-store endpoint URL (MinIO locally, DigitalOcean Spaces in production).
S3_ENDPOINT=http://localhost:9000

# Object-store region (e.g. us-east-1 for MinIO, nyc3 for the production Spaces
# bucket).
S3_REGION=us-east-1

# Object-store secret key paired with S3_ACCESS_KEY.
S3_SECRET_KEY=minioadmin

# Server-side-encryption mode sent on object PUTs (e.g. AES256, aws:kms). Empty
# disables it.
S3_SERVER_SIDE_ENCRYPTION=

# KMS key id used when S3_SERVER_SIDE_ENCRYPTION is aws:kms.
S3_SSE_KMS_KEY_ID=

# DigitalOcean Spaces access key for the source-ingest tooling
# (scripts/ingest_from_spaces.py).
# SPACES_KEY=

# DigitalOcean Spaces secret paired with SPACES_KEY, used by the source-ingest
# tooling.
# SPACES_SECRET=

# ===== Outbound email (SMTP) ==========

# Recipient for the prod-check SMTP delivery test; falls back to
# DOCRAY_SMTP_FROM.
# DOCRAY_SMTP_CHECK_TO=

# From address on verification and notification email (e.g. noreply@doc-
# ray.com).
# DOCRAY_SMTP_FROM=

# SMTP relay hostname for outbound mail.
# DOCRAY_SMTP_HOST=

# SMTP relay password.
# DOCRAY_SMTP_PASSWORD=

# SMTP relay port. Note: DigitalOcean blocks 25/465/587; production uses 2525 on
# SMTP2GO.
DOCRAY_SMTP_PORT=587

# Use implicit TLS for SMTP (true for port 465). Mutually exclusive with
# STARTTLS.
# DOCRAY_SMTP_SSL=

# When true, upgrade the SMTP connection with STARTTLS.
DOCRAY_SMTP_STARTTLS=true

# SMTP connection/operation timeout, in seconds.
DOCRAY_SMTP_TIMEOUT_SECONDS=10

# SMTP relay username.
# DOCRAY_SMTP_USERNAME=

# ===== Authentication & sessions ==========

# When true, unauthenticated API requests run as an anonymous, RLS-scoped
# principal instead of being rejected. Turn off to require a token on every
# request.
DOCRAY_API_ALLOW_ANONYMOUS=true

# Expected `aud` claim on locally issued API JWTs. Empty disables audience
# checking.
DOCRAY_API_JWT_AUDIENCE=

# `iss` claim stamped on, and verified for, locally issued API JWTs.
DOCRAY_API_JWT_ISSUER=doc-ray

# Locally issued API JWTs (BL-071/BL-072). Set DOCRAY_API_JWT_SECRET to enable
# /auth/token exchange from a valid static credential. Access tokens are short-
# lived; refresh tokens allow rotation without reusing the static secret.
# DOCRAY_API_JWT_SECRET=

# Lifetime of a locally issued API access token, in seconds.
DOCRAY_API_JWT_TTL_SECONDS=900

# Break-glass only. When true, the API still accepts static DOCRAY_API_TOKENS
# after OIDC is configured; OIDC wins when both authenticate. Keep false in
# production so OIDC is the only path.
DOCRAY_API_OIDC_ALLOW_STATIC_TOKEN_FALLBACK=false

# Expected `aud` claim on OIDC access tokens presented to the API.
# DOCRAY_API_OIDC_AUDIENCE=

# When true, a valid OIDC token for an unknown subject provisions a new
# principal on first use instead of being rejected.
DOCRAY_API_OIDC_AUTO_CREATE_PRINCIPALS=false

# OIDC issuer URL the API trusts; its discovery document supplies the signing
# keys.
# DOCRAY_API_OIDC_ISSUER=

# Inline JWKS (JSON) overriding OIDC discovery — for airgapped or pinned-key
# deployments.
DOCRAY_API_OIDC_JWKS_JSON=

# Lifetime of an API refresh token, in seconds. Refresh tokens rotate access
# tokens without reusing the static secret.
DOCRAY_API_REFRESH_TOKEN_TTL_SECONDS=86400

# Leave empty for local anonymous access scoped by database RLS.
# DOCRAY_API_TOKENS=

# How long an email-verification link stays valid, in seconds.
DOCRAY_AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400

# TEST/dev only: when true, the registration response returns the raw
# verification token instead of only emailing it. Never enable in production.
DOCRAY_AUTH_EXPOSE_VERIFICATION_TOKEN=false

# Local self-service registration/login. Admin principals remain seed/operator-
# managed; registered users receive the reader role and must verify email before
# login. Keep verification-token exposure false outside tests/local diagnostics;
# production should deliver the token by email.
DOCRAY_AUTH_LOCAL_ENABLED=false

# How long an account is locked after too many failed logins, in seconds.
DOCRAY_AUTH_LOCKOUT_SECONDS=900

# Failed-login attempts allowed before the account is locked for
# DOCRAY_AUTH_LOCKOUT_SECONDS.
DOCRAY_AUTH_MAX_FAILED_LOGINS=10

# When true, the webapp exposes self-service local account registration.
# Requires DOCRAY_AUTH_LOCAL_ENABLED.
DOCRAY_AUTH_REGISTRATION_ENABLED=false

# Principal id stamped on every webapp DB request to enable row-level security.
# Unset means superuser passthrough — local/dev only.
# DOCRAY_PRINCIPAL_ID=

# IdP is syncing principals/groups into /scim/v2/{tenant_id}.
# DOCRAY_SCIM_TOKENS=

# Expected `aud` claim on OIDC tokens accepted by the webapp login flow.
# DOCRAY_WEBAPP_OIDC_AUDIENCE=

# OIDC browser login. Configure authorization + token endpoints, client id, and
# JWKS/issuer values. The API OIDC issuer/audience/JWKS settings are reused when
# the webapp-specific variants are unset.
DOCRAY_WEBAPP_OIDC_AUTHORIZATION_URL=

# OAuth2/OIDC client id the webapp uses for the Authorization Code login flow.
DOCRAY_WEBAPP_OIDC_CLIENT_ID=

# OAuth2/OIDC client secret paired with DOCRAY_WEBAPP_OIDC_CLIENT_ID.
DOCRAY_WEBAPP_OIDC_CLIENT_SECRET=

# OIDC issuer URL for the webapp login flow; supplies discovery + signing keys.
# DOCRAY_WEBAPP_OIDC_ISSUER=

# Inline JWKS (JSON) overriding OIDC discovery for the webapp login flow.
# DOCRAY_WEBAPP_OIDC_JWKS_JSON=

# Space-separated OAuth scopes the webapp requests at login.
DOCRAY_WEBAPP_OIDC_SCOPE=openid email profile

# OIDC token endpoint; set to override the value from issuer discovery.
DOCRAY_WEBAPP_OIDC_TOKEN_URL=

# When true, the webapp requires a signed-in session for corpus pages (login-
# gated deployment).
DOCRAY_WEBAPP_REQUIRE_AUTH=false

# When true, the webapp accepts unsigned SAML assertions. Insecure — dev/testing
# only.
DOCRAY_WEBAPP_SAML_ALLOW_UNSIGNED_ASSERTIONS=

# Entity ID of the SAML identity provider the webapp federates with.
DOCRAY_WEBAPP_SAML_IDP_ENTITY_ID=

# This service's SAML service-provider entity ID, as registered with the IdP.
DOCRAY_WEBAPP_SAML_SP_ENTITY_ID=

# IdP single-sign-on redirect URL the webapp sends SAML AuthnRequests to.
DOCRAY_WEBAPP_SAML_SSO_URL=

# Tenant the SAML IdP config binds to, so assertions map to the right tenant's
# principals.
DOCRAY_WEBAPP_SAML_TENANT_ID=

# Signs the session cookie carrying each session's CSRF token (BL-103). Unset
# falls back to a random key generated at process start (dev-only — every
# session is invalidated on restart); set explicitly for a real deployment.
# DOCRAY_WEBAPP_SECRET_KEY=

# When true, the webapp session cookie is marked Secure (HTTPS-only). Keep true
# in production.
DOCRAY_WEBAPP_SESSION_COOKIE_SECURE=true

# Where webapp login sessions live. 'postgres' persists them in the
# web_auth_sessions table so a restart or a second replica does not log everyone
# out; 'memory' keeps them in-process (single instance, lost on restart).
# Compose defaults to 'postgres'.
DOCRAY_WEBAPP_SESSION_STORE=memory

# Webapp login session lifetime, in seconds.
DOCRAY_WEBAPP_SESSION_TTL_SECONDS=28800

# ===== MCP server ==========

# Comma-separated Host header allow-list for the MCP server's DNS-rebind guard.
# Set to the public hostname or the SDK answers 421.
DOCRAY_MCP_ALLOWED_HOSTS=

# When true, the MCP server exposes write tools; default is read-only.
DOCRAY_MCP_ENABLE_WRITE=false

# Maximum total outbound GraphQL connections retained by the process-wide MCP
# HTTP pool.
DOCRAY_MCP_POOL_MAX_CONNECTIONS=100

# Maximum idle outbound GraphQL connections retained by the process-wide MCP
# HTTP pool.
DOCRAY_MCP_POOL_MAX_KEEPALIVE=20

# Max MCP requests per principal (token fingerprint, else client IP) within the
# window; a generous default that only catches runaway loops. 0 disables
# throttling. In-process per container — with N replicas the effective limit is
# N×. Never applies to /health or /readyz.
DOCRAY_MCP_RATE_LIMIT_REQUESTS=120

# Fixed-window length in seconds for DOCRAY_MCP_RATE_LIMIT_REQUESTS. 0 disables
# throttling.
DOCRAY_MCP_RATE_LIMIT_WINDOW_SECONDS=60

# OAuth protected-resource identifier the MCP server advertises to connecting
# agents.
DOCRAY_MCP_RESOURCE=

# URL of the MCP OAuth protected-resource metadata document.
DOCRAY_MCP_RESOURCE_METADATA_URL=

# Per-request GraphQL timeout (seconds) for the MCP tools:
DOCRAY_MCP_TIMEOUT_SECONDS=30

# ===== Webapp ==========

# GraphQL endpoint the webapp posts mutations to (entrypoints.api service URL).
DOCRAY_API_URL=http://localhost:8000/graphql

# Caps upload size in MB before it's fully buffered for hashing — enforced by
# both the webapp's Flask route and the GraphQL ingestDocument mutation
# (BL-098).
DOCRAY_MAX_UPLOAD_MB=200

# Bearer token required to view /operator/health; unset hides the page (404).
# DOCRAY_OPERATOR_HEALTH_TOKEN=

# Absolute base URL used in emailed verification links (required for the API
# surface; the webapp falls back to the request host when unset).
DOCRAY_PUBLIC_BASE_URL=

# Token the webapp presents to the API for its thin write path (uploads,
# seeding), distinct from its read-only DB connection.
# DOCRAY_WEBAPP_API_TOKEN=

# Max unauthenticated login requests per client within the window.
DOCRAY_WEBAPP_LOGIN_RATE_LIMIT_REQUESTS=10

# Rolling window (seconds) for the login rate limit.
DOCRAY_WEBAPP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Max unauthenticated registration requests per client within the window.
DOCRAY_WEBAPP_REGISTER_RATE_LIMIT_REQUESTS=5

# Rolling window (seconds) for the registration rate limit.
DOCRAY_WEBAPP_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Max unauthenticated verification-email resend requests per client within the
# window.
DOCRAY_WEBAPP_RESEND_RATE_LIMIT_REQUESTS=5

# Rolling window (seconds) for the verification-email resend rate limit.
DOCRAY_WEBAPP_RESEND_RATE_LIMIT_WINDOW_SECONDS=3600

# Max unauthenticated search requests per client within the window.
DOCRAY_WEBAPP_SEARCH_RATE_LIMIT_REQUESTS=60

# Rolling window (seconds) for the search rate limit.
DOCRAY_WEBAPP_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# Max unauthenticated upload requests per client within the window.
DOCRAY_WEBAPP_UPLOAD_RATE_LIMIT_REQUESTS=10

# Rolling window (seconds) for the upload rate limit.
DOCRAY_WEBAPP_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Flask port when the webapp runs as `python -m webapp.app`.
PORT=5001

# ===== Workers & job queue ==========

# Overrides the probed compute-device string recorded on job telemetry, for
# hosts where the runtime cannot see what it is really using (a MIG slice, a
# shared card). Leave unset to use the probe.
# DOCRAY_DEVICE_LABEL=

# Heartbeat age (seconds) past which the job page stops trusting a running job's
# progress numbers and warns instead (the backend already considers such a
# heartbeat reclaimable). Mirrors WORKER_CLAIM_TIMEOUT_SECONDS' default;
# deliberately tighter than DOCRAY_WEBAPP_STALLED_AFTER_SECONDS. Default: 120.
DOCRAY_WEBAPP_HEARTBEAT_RECLAIM_ELIGIBLE_SECONDS=120

# A running job whose heartbeat is older than this (seconds) renders as "Stalled
# (worker lost)" and stops blocking the reprocess buttons. Keep well above
# WORKER_CLAIM_TIMEOUT_SECONDS to avoid flapping. Default: 300.
DOCRAY_WEBAPP_STALLED_AFTER_SECONDS=300

# Machine name stamped on every telemetry row so GPU hours are attributable to a
# host you can put on an invoice. Defaults to the container hostname, which
# changes on every restart and names nothing; set it to the droplet name on an
# ephemeral GPU worker.
# DOCRAY_WORKER_HOST=

# Seconds the full-pass orchestrator waits for progress before treating a stage
# as stalled.
FULL_PASS_WATCHDOG=900

# Worker count for a full re-processing pass; the orchestrator uses more (16)
# during the extract phase and fewer (4) otherwise.
# FULL_PASS_WORKERS=

# How long a worker holds a claimed job before it is considered abandoned and
# reclaimable.
WORKER_CLAIM_TIMEOUT_SECONDS=120

# Comma-separated long-running job kinds the CPU fast-lane Compose service must
# not claim; keep GPU-only visual_embed on the heavy worker.
WORKER_FAST_EXCLUDE_KINDS=annotate,reannotate,visual_extract,semantic_embed,visual_embed

# Interval at which a running worker updates its job heartbeat.
WORKER_HEARTBEAT_SECONDS=15

# use WORKER_JOB_TIMEOUT_<KIND>_SECONDS, e.g. WORKER_JOB_TIMEOUT_BACKUP_SECONDS.
# Defaults: 3600 for any kind, 60 for Claude resolver HTTP calls.
WORKER_JOB_TIMEOUT_SECONDS=3600.0

# Maximum wall-clock time for a Tier-2 visual_embed job on the heavy worker
# lane.
WORKER_JOB_TIMEOUT_VISUAL_EMBED_SECONDS=14400

# Comma-separated allowlist of job kinds a worker may claim; everything else is
# left to other lanes. Set on a worker-ONLY GPU host so it never claims a user-
# facing fast-lane job. An allowlist fails safe — a job kind added later is not
# claimed here until someone decides it belongs on GPU hardware.
# WORKER_ONLY_KINDS=

# Seconds a worker waits between job-claim attempts when the queue is empty.
WORKER_POLL_SECONDS=5

# Janitor cadence: stale jobs are reaped on this timer even while every worker
# is busy inside a long handler (recovery otherwise waits for a free slot).
WORKER_REAP_SECONDS=30

# Backoff before reconnecting after a dropped DB connection (BL-101), so a
# transient blip doesn't crash the worker process. Default: 2.
WORKER_RECONNECT_BACKOFF_SECONDS=2

# ===== Backups ==========

# Master switch for the in-app backup subsystem — the scheduler, the
# backup/restore job kinds, the archive download route, and the admin backup UI.
# Off (the default) means no backup job is ever enqueued or executed and corpus
# durability is the managed database layer's responsibility. Note that the in-
# app archive was the only thing that captured object-store blobs; managed-
# database backups cover the database only.
DOCRAY_BACKUP_ENABLED=false

# Newest N backup archives always kept by the retention pruner.
DOCRAY_BACKUP_RETENTION_COUNT=7

# Archives older than this many days are pruned, beyond the always-kept newest
# N.
DOCRAY_BACKUP_RETENTION_DAYS=30

# Interval between automatic backup runs by the backup-scheduler, in seconds.
DOCRAY_BACKUP_SCHEDULE_SECONDS=86400

# ===== Document extraction ==========

# Zip-bomb guard: cap on total uncompressed bytes when extracting EPUB/DOCX
# (both are zip containers). Empty uses the built-in limit.
DOCRAY_EXTRACT_MAX_UNCOMPRESSED_MB=

# A bold body-size line is treated as a heading only if it has at most this many
# words.
DOCRAY_PDF_HEADING_BOLD_MAX_WORDS=10

# Font-size ratio (vs body text) at or above which a PDF line is promoted to a
# level-1 heading.
DOCRAY_PDF_HEADING_L1_RATIO=1.5

# Font-size ratio threshold for a level-2 PDF heading.
DOCRAY_PDF_HEADING_L2_RATIO=1.25

# Font-size ratio threshold for a level-3 PDF heading.
DOCRAY_PDF_HEADING_L3_RATIO=1.1

# Optional PDF math-extraction backend. Set to `external` to route formula
# regions through DOCRAY_PDF_MATH_BACKEND_CMD.
DOCRAY_PDF_MATH_BACKEND=

# Command line for the external PDF math-extraction backend, when
# DOCRAY_PDF_MATH_BACKEND selects an external tool.
DOCRAY_PDF_MATH_BACKEND_CMD=

# Timeout in seconds for the external PDF math-extraction backend command.
DOCRAY_PDF_MATH_BACKEND_TIMEOUT=120

# OCR a PDF that extracts to zero text (a scan). On by default; set
# 0/false/no/off to record the failure instead.
DOCRAY_PDF_OCR=1

# Tesseract language pack used when OCR runs on image-only PDF pages. The
# runtime image ships `eng` and `por`.
DOCRAY_PDF_OCR_LANGUAGE=eng

# How the annotate job reacts when the configured spaCy model is unavailable:
# `fail` (default) aborts; other values fall back.
DOCRAY_SPACY_FALLBACK_POLICY=fail

# Tesseract language-data directory. Leave empty to let the extractor discover
# the installed one; set it to override.
TESSDATA_PREFIX=

# ===== Entity resolver (LLM) ==========

# Anthropic API key, used when the entity resolver is pointed at a Claude model
# instead of local Ollama.
# ANTHROPIC_API_KEY=

# Query-safety caps (schema.py) — max GraphQL query nesting depth and max
# token/complexity count. Defaults: 12 and 2000.
API_MAX_DEPTH=12

# Max output tokens requested from the resolver model per call.
API_MAX_TOKENS=2000

# Base URL of the Ollama server the entity resolver calls (in-network on the GPU
# in production).
DOCRAY_OLLAMA_HOST=http://localhost:11434

# Ollama model tag used for entity resolution.
DOCRAY_OLLAMA_MODEL=qwen2.5

# Selects the entity-resolver backend: `anthropic` (default) or `ollama`.
DOCRAY_RESOLVER_BACKEND=anthropic

# Model identifier the entity-canonicalization resolver uses.
# DOCRAY_RESOLVER_MODEL=

# Per-call timeout for the resolver model, in seconds. Compose pins 60 for both
# worker lanes; code fallbacks differ per backend (Claude 60, Ollama 120) when
# unset.
DOCRAY_RESOLVER_TIMEOUT_SECONDS=60

# Ollama server URL read by ancillary tooling; mirrors DOCRAY_OLLAMA_HOST.
OLLAMA_HOST=http://localhost:11434

# ===== Visual pipeline (Prism) ==========

# Parallel workers for the visual-captioning pass.
CAPTION_CONCURRENCY=64

# Cap on images captioned per run (0 = no limit).
CAPTION_LIMIT=0

# When 1, run OCR alongside captioning on document images.
CAPTION_OCR=0

# Classification fan-out (scripts/prism_classify.py).
CLASSIFY_CONCURRENCY=48

# Replica count for the caption-only worker pool (docker-compose.caption.yml).
# Keep 2 with local Ollama (it serializes vision decode); raise only against a
# horizontally scaling vllm endpoint. On DigitalOcean serverless inference the
# limit is DO's shared per-model admission control, not the account quota, and 6
# is the measured knee — past it throughput inverts as lanes stall in 429
# backoff.
DOCRAY_CAPTION_WORKERS=2

# Maximum images or sentence texts sent to the Tier-2 dual encoder per call;
# lower this positive integer on memory-constrained GPU workers.
DOCRAY_VISION_BATCH_SIZE=16

# open_clip Tier-2 model architecture for the cross-modal image/sentence
# encoder.
DOCRAY_VISION_MODEL=ViT-L-14

# open_clip pretrained-weights tag for the Tier-2 cross-modal image/sentence
# encoder.
DOCRAY_VISION_PRETRAINED=openai

# Bearer token for a hosted OpenAI-compatible VLM endpoint (e.g. DigitalOcean
# serverless inference). Unset sends no Authorization header, which a local vLLM
# neither needs nor checks.
# DOCRAY_VLM_API_KEY=

# Tier-3 caption VLM backend for the visual_caption worker handler and the
# queue-free Prism operator scripts: ollama (default) or vllm (any OpenAI-
# compatible /chat/completions endpoint, local vLLM or hosted serverless).
# DOCRAY_VLM_BACKEND=

# OpenAI-compatible /v1 base URL for the vllm backend — a local vLLM (saturates
# the GPU at image granularity) or a hosted serverless endpoint such as
# https://inference.do-ai.run/v1.
DOCRAY_VLM_ENDPOINT=http://localhost:8011/v1

# Longest-edge pixel cap applied to images before sending them to the vision-
# language model.
DOCRAY_VLM_IMAGE_MAX_PX=1024

# Tier-3 grounded-caption VLM served via Ollama, and the Ollama host. Use an
# *Instruct* vision model (no hidden reasoning) so the token budget produces the
# description; qwen3-vl:32b-instruct is the most capable that fits a single
# H200.
DOCRAY_VLM_MODEL=qwen3-vl-8b

# Max tokens the VLM generates per caption (backend default: 768 ollama / 400
# vLLM).
DOCRAY_VLM_NUM_PREDICT=768

# Tesseract language for OCR-of-crop grounding evidence (Tier-3). The caption is
# grounded against page text PLUS this OCR of the crop; it is never shown to the
# VLM.
DOCRAY_VLM_OCR_LANGUAGE=eng

# Sampling temperature for the vision-language model.
DOCRAY_VLM_TEMPERATURE=0.1

# Loopback port for the scripts/prism_gallery.py review UI.
PRISM_GALLERY_PORT=8013

# Scratch directory for the Prism visual pipeline's intermediate artifacts.
# PRISM_WORK_DIR=

# ===== Billing (Stripe) ==========

# In-network URL the admin-console nginx proxies GraphQL calls to. Consumed by
# docker-compose (admin-console project), not read by application code.
ADMIN_API_UPSTREAM=http://api:8000

# Loopback host port the admin-console compose service publishes (127.0.0.1
# only; public access is via the Cloudflare Tunnel). Consumed by docker-compose,
# not read by application code.
ADMIN_CONSOLE_PORT=8080

# In-network URL the admin-console nginx proxies webapp links to. Consumed by
# docker-compose (admin-console project), not read by application code.
ADMIN_WEBAPP_UPSTREAM=http://webapp:5001

# Leave disabled locally; production enables this after Stripe webhooks are
# live.
DOCRAY_BILLING_ENFORCEMENT_ENABLED=false

# Name of the main stack's external docker network that the admin-console
# compose project attaches to (compose project name + `_default`). Consumed by
# docker-compose, not read by application code.
DOCRAY_NETWORK=doc-ray_default

# Stripe API base URL; override to point at a mock/sandbox in tests.
DOCRAY_STRIPE_API_BASE=https://api.stripe.com/v1

# URL Stripe redirects to when Checkout is cancelled.
DOCRAY_STRIPE_CANCEL_URL=

# URL the Stripe billing portal returns the customer to.
DOCRAY_STRIPE_PORTAL_RETURN_URL=

# Stripe Price id offered at Checkout for the subscription.
DOCRAY_STRIPE_PRICE_ID=

# Stripe secret API key for Checkout/Portal/webhook calls. Configure the public
# Stripe webhook endpoint and subscribe it to: checkout.session.completed,
# checkout.session.expired, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_succeeded, invoice.payment_failed, and
# invoice.finalization_failed.
DOCRAY_STRIPE_SECRET_KEY=

# URL Stripe redirects to after a successful Checkout.
DOCRAY_STRIPE_SUCCESS_URL=

# Signing secret used to verify inbound Stripe webhook events. A missing event
# leaves a subscription silently stale rather than failing loudly. Create one
# endpoint in the Stripe dashboard pointing at <public-base-url>/stripe/webhook
# and subscribe it to: checkout.session.completed, checkout.session.expired,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_succeeded,
# invoice.payment_failed, invoice.finalization_failed
DOCRAY_STRIPE_WEBHOOK_SECRET=

# ===== Logging & observability ==========

# DigitalOcean API token used by the observability overlay to read
# infrastructure inventory and month-to-date spend. Read scope is sufficient —
# this never creates or destroys resources.
# DIGITALOCEAN_TOKEN=

# GraphQL introspection + the interactive GraphiQL IDE are disabled unless this
# is set — an anonymous caller (the default above) should not be able to
# enumerate the schema, including admin-only mutation shapes, for free
# reconnaissance. Set true only for local development.
DOCRAY_API_DEBUG=false

# Log output format; empty selects the default. Set to `json` for structured
# logs.
DOCRAY_LOG_FORMAT=

# Log level for the worker and API processes (doc_ray.logging_setup):
# DEBUG/INFO/WARNING/ERROR.
DOCRAY_LOG_LEVEL=INFO

# Seconds between DigitalOcean billing API polls (scripts/do_cost_probe.py).
# Billing figures move hourly at most and the API is rate limited; polling
# faster burns quota for the same number.
DO_COST_PROBE_INTERVAL=900

# Loopback port for the DigitalOcean inventory exporter.
DO_EXPORTER_PORT=9212

# Grafana admin password for the observability overlay. Required when that
# overlay runs; Grafana is reached over an SSH tunnel and never published.
# GRAFANA_ADMIN_PASSWORD=

# Loopback port for Grafana. Defaults to 3001 because the operator lab's Open
# WebUI already binds 3000 on loopback; both stacks must be able to run at once.
GRAFANA_PORT=3001

# Loopback port for the host metrics exporter (also serves the DigitalOcean
# billing textfile).
NODE_EXPORTER_PORT=9100

# Loopback port for the PostgreSQL exporter that reads the managed cluster and
# doc-ray's job_telemetry rollups.
PG_EXPORTER_PORT=9187

# Loopback port for Prometheus.
PROM_PORT=9090

# Prometheus retention window. Long enough to show a month-over-month cost trend
# — this series is a spend record, not a debugging buffer.
PROM_RETENTION=90d

# ===== Operations & tooling ==========

# Overrides the migration directory the runner/entrypoints.migrate reads from
# (defaults to the packaged db/migrations); mainly a test/packaging hook.
# DOCRAY_MIGRATIONS_DIR=

# Seconds between operation-scheduler ticks, which fire due rows in
# operation_schedule. Schedules fire at minute granularity, so polling faster
# only burns connections.
DOCRAY_OPERATION_SCHEDULER_INTERVAL=60

# Explicit local override for DB-backed integration tests pointed at a non-test
# database. Leave disabled; prefer scripts/test-in-docker.sh for validation.
# DOCRAY_TEST_ALLOW_LIVE_DB=

# Output directory for scripts/visual_check.py screenshots (defaults under the
# gitignored _ephemeral/).
# DOCRAY_VISUAL_OUT=

# ===== Nlp ==========

# device for the Layer 20 sentence encoder: auto (default) lets sentence-
# transformers pick CUDA when the worker container can see a GPU, else CPU; set
# cpu/cuda/cuda:N/mps to force one (e.g. cpu when an 8 GB card is held by trf
# annotation).
DOCRAY_SEMANTIC_DEVICE=auto

# sentence-transformers model for NLP Layer 20 learned sentence embeddings; must
# be 768-dim to match the embedding column.
DOCRAY_SEMANTIC_MODEL=sentence-transformers/all-mpnet-base-v2
