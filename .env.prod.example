# doc-ray — PRODUCTION environment file (docker-compose.prod.yml).
#
# Copy to .env.prod (gitignored; chmod 600) and fill in. Production is loaded
# with its OWN env file, never the development .env:
#   make prod-up   ==  docker compose --env-file .env.prod \
#                        -f docker-compose.yml -f docker-compose.prod.yml up -d ...
#
# --env-file REPLACES .env for interpolation, so this file needs ONLY the
# production-specific values; every other knob inherits its base-compose default
# (${VAR:-default}). Keep development values in .env — never mix the two.

# === Managed Postgres (DO Managed cluster, direct endpoint, TLS) ===
DATABASE_URL=postgresql://docray:<APP_PASSWORD>@<CLUSTER_HOST>:25060/docray?sslmode=require
# The base compose interpolates ${POSTGRES_PASSWORD} across every service even
# though the local postgres container never starts in prod (it is gated out).
# Give it any non-default value so interpolation succeeds; it is otherwise unused.
POSTGRES_PASSWORD=<any-non-default-value>

# === Spaces object store (S3) ===
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=doc-ray-prd
S3_ACCESS_KEY=<SPACES_ACCESS_KEY>
S3_SECRET_KEY=<SPACES_SECRET_KEY>
S3_REGION=nyc3
S3_ALLOW_INSECURE_ENDPOINT=0

# === API — fail closed in production ===
DOCRAY_API_ALLOW_ANONYMOUS=false
DOCRAY_API_DEBUG=
DOCRAY_API_JWT_SECRET=<openssl rand -hex 32>
# Static write-scoped principal tokens (token=principal_uuid:read+write). Seed an
# admin principal first (see docs/production-setup.md Step 5), then set this.
DOCRAY_API_TOKENS=

# === Local browser auth — so the public UI is not an open corpus ===
DOCRAY_AUTH_LOCAL_ENABLED=true
DOCRAY_AUTH_REGISTRATION_ENABLED=true
DOCRAY_WEBAPP_REQUIRE_AUTH=true
DOCRAY_WEBAPP_SECRET_KEY=<openssl rand -hex 32>
DOCRAY_WEBAPP_SESSION_COOKIE_SECURE=true
# One of DOCRAY_API_TOKENS — lets the webapp authorize its write path to the API.
DOCRAY_WEBAPP_API_TOKEN=
DOCRAY_PUBLIC_BASE_URL=https://doc-ray.com

# === Stripe billing ===
# Create a recurring Price in Stripe, configure a webhook endpoint at
# https://doc-ray.com/stripe/webhook, and subscribe it to:
# checkout.session.completed, checkout.session.expired,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed,
# and invoice.finalization_failed.
DOCRAY_STRIPE_SECRET_KEY=<sk_live_...>
DOCRAY_STRIPE_WEBHOOK_SECRET=<whsec_...>
DOCRAY_STRIPE_PRICE_ID=<price_...>
# Hosted Checkout/Portal should return to the admin console Billing panel. The
# console also sends these same-origin URLs as per-session overrides; keep this
# configured origin equal to the trusted HTTPS origin where operators open it.
DOCRAY_STRIPE_SUCCESS_URL=https://admin.doc-ray.com/billing?checkout=success
DOCRAY_STRIPE_CANCEL_URL=https://admin.doc-ray.com/billing?checkout=cancel
DOCRAY_STRIPE_PORTAL_RETURN_URL=https://admin.doc-ray.com/billing
DOCRAY_BILLING_ENFORCEMENT_ENABLED=true

# === Admin console (React backoffice + Stripe Billing panel) ===
# Started separately with `make prod-admin-console-up`; it attaches to the main
# compose network and proxies the API/webapp on the same origin.
ADMIN_CONSOLE_PORT=8080
DOCRAY_NETWORK=doc-ray_default
ADMIN_API_UPSTREAM=http://api:8000
ADMIN_WEBAPP_UPSTREAM=http://webapp:5001

# === SMTP — required for registration email verification (else /register 503s) ===
DOCRAY_SMTP_HOST=
DOCRAY_SMTP_PORT=587
DOCRAY_SMTP_FROM=noreply@doc-ray.com
DOCRAY_SMTP_USERNAME=
DOCRAY_SMTP_PASSWORD=
DOCRAY_SMTP_STARTTLS=true

# === Cloudflare Tunnel ingress (docker-compose.cloudflared.yml) ===
# Token from Cloudflare Zero Trust -> Networks -> Tunnels. Enables `make prod-tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# === Frontier entity resolver — LOCAL Ollama instead of Anthropic ===
# The ollama overlays (make prod-ollama-up) route the workers to a local model
# (no API key, no per-call cost); the backend defaults to `ollama` there. Set the
# model (any tool/JSON-capable id; the benchmark winner). The GPU overlay needs
# the NVIDIA CDI spec present (scripts/provision_host.py).
DOCRAY_OLLAMA_MODEL=qwen2.5
# DOCRAY_RESOLVER_BACKEND=ollama   # (the ollama overlay already sets this on the workers)

# === Concurrency ===
# NLP worker replicas (annotate/enrich).
DOCRAY_WORKERS=3
# API is stateless — multiple uvicorn workers are safe.
DOCRAY_API_WORKERS=2
# Webapp MUST stay at 1: the login-session store is in-process, so >1 worker
# makes logins intermittently fail ("authentication required"). Concurrency comes
# from gunicorn threads, not workers. Raise only after moving to a shared store.
DOCRAY_WEBAPP_WORKERS=1
